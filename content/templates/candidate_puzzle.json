  "blocks": {"allow": ["arith.add", "arith.max", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.gt", "ctrl.break", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "var.dec", "var.get", "var.inc", "var.set"], "maxBlocks": 51},
