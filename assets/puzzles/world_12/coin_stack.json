{
  "id": "coin_stack",
  "version": 1,
  "title": "Stack of Coins",
  "world": "world_12",
  "chapter": "recursive_list_sum",
  "tier": 3,
  "mode": "build",
  "concepts": ["recursion"],
  "prerequisites": [],
  "story": "Add up a stack of coins, listed from top to bottom, without any loop. The function sum_from(stack, i) gives the total of the coins from position i down to the bottom: coin i plus the total of the coins below it. Past the last coin there is nothing to add. The program returns the total of the whole stack.",
  "io": {
    "inputs": [
      {"name": "coins", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 60},
    "notes": ["Coins are worth 0 to 100."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.ge", "ctrl.if", "ctrl.return", "fn.call2", "lit.num", "var.get"],
    "maxBlocks": 36
  },
  "limits": {"maxOps": 1850, "maxDepth": 80, "maxAlloc": 100},
  "hints": ["A FUNCTION may CALL itself on a smaller part of the problem: the coins below i are a smaller stack.", "sum_from(stack, i) is coin i PLUS CALL sum_from(stack, i PLUS 1).", "Stop when i reaches the LENGTH of the stack and RETURN 0 there; an empty stack has no last coin. The program RETURNs CALL sum_from(coins, 0)."],
  "validators": {"output": "equal"},
