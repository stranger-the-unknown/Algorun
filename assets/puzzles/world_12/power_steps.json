        "id": "h03",
        "in": {"base": 10, "exp": 4},
        "out": 0
      },
      {
        "id": "h04",
        "in": {"base": 9999, "exp": 2},
        "out": 1
      },
      {
        "id": "h05",
        "in": {"base": 2, "exp": 1000000000},
        "out": 9376
      },
      {
        "id": "h06",
        "in": {"base": 1234, "exp": 987654321},
        "out": 9184
      },
      {
        "id": "h07",
        "in": {"base": 3, "exp": 1000000},
        "out": 1
      }
    ]
  },
  "edgeCases": ["a huge exponent", "the power 0", "a base ending in zeros"],
  "variables": {
