{
  "id": "catalogue_check",
  "version": 1,
  "title": "Catalogue Check",
  "world": "world_12",
  "chapter": "bounds_passed_down",
  "tier": 4,
  "mode": "build",
  "concepts": ["recursion"],
  "prerequisites": ["tree"],
  "story": "A search tree must keep its order everywhere: every label in a node's left branch is smaller than the node's label, and every label in its right branch is larger. Not just the children — all of them. Labels are different whole numbers from 1 to 1000. Is the tree in order? ok(node, low, high) says whether every label in this branch lies strictly between low and high.",
  "io": {
    "inputs": [
      {"name": "root", "type": "treeNode?"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 150},
    "notes": ["Labels are different whole numbers from 1 to 1000."]
  },
  "blocks": {
    "allow": ["cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.if", "ctrl.return", "fn.call3", "lit.bool", "lit.num", "logic.and", "logic.is_not_nothing", "logic.is_nothing", "logic.not", "logic.or", "tree.left", "tree.right", "tree.value", "var.get", "var.set"],
    "maxBlocks": 61
  },
  "limits": {"maxOps": 9650, "maxDepth": 64, "maxAlloc": 100},
  "hints": ["The root may hold any label from 1 to 1000: start with ok(root, 0, 1001).", "A node must lie between low and high; then its LEFT branch must lie between low and the node's label, and its RIGHT branch between the label and high.", "Comparing a node only with its own children misses a grandchild on the wrong side of the root."],
  "validators": {"output": "equal"},
