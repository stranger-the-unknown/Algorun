{
  "id": "even_branches",
  "version": 1,
  "title": "Even Branches",
  "world": "world_12",
  "chapter": "balanced_height_or_minus_one",
  "tier": 4,
  "mode": "build",
  "concepts": ["recursion"],
  "prerequisites": ["tree"],
  "story": "A tree is evenly grown when, at every node, its two branches differ by at most 1 in their number of levels (an empty branch has 0 levels). Is the whole tree evenly grown? The function levels(node) gives the number of levels of a branch, or -1 as soon as some node inside it is lopsided.",
  "io": {
    "inputs": [
      {"name": "root", "type": "treeNode?"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 63},
    "notes": ["Labels are whole numbers from 1 to 99."]
  },
  "blocks": {
    "allow": ["arith.abs", "arith.add", "arith.max", "arith.sub", "cmp.eq", "cmp.gt", "cmp.le", "cmp.ne", "ctrl.else", "ctrl.if", "ctrl.return", "fn.call1", "lit.bool", "lit.num", "logic.is_not_nothing", "logic.is_nothing", "tree.left", "tree.right", "var.get", "var.set"],
    "maxBlocks": 76
  },
  "limits": {"maxOps": 2600, "maxDepth": 64, "maxAlloc": 100},
  "hints": ["Ask each branch for its levels; if either says -1, the answer is -1 too.", "Otherwise, if the two differ by more than 1 (ABSOLUTE of the difference), RETURN -1; else RETURN 1 PLUS the larger one.", "The tree is evenly grown when levels(root) is NOT EQUAL to -1. Comparing only the root's two branches misses a lopsided node deeper down."],
  "validators": {"output": "equal"},
