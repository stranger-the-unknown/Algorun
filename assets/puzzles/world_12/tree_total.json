  "world": "world_12",
  "chapter": "recursive_tree_sum",
  "tier": 3,
  "mode": "build",
  "concepts": ["recursion"],
  "prerequisites": ["tree"],
  "story": "Every node of a tree holds a number, some of them negative. Add them all up with the function total(node): an empty branch adds 0, and a node adds its own number to the totals of its two branches.",
  "io": {
    "inputs": [
      {"name": "root", "type": "treeNode?"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 60},
    "notes": ["Numbers are whole numbers from -50 to 50."]
  },
  "blocks": {
    "allow": ["arith.add", "ctrl.else", "ctrl.if", "ctrl.return", "fn.call1", "lit.num", "logic.is_not_nothing", "logic.is_nothing", "tree.left", "tree.right", "tree.value", "var.get"],
    "maxBlocks": 34
  },
  "limits": {"maxOps": 2300, "maxDepth": 64, "maxAlloc": 100},
  "hints": ["No loop is needed: the two branches are smaller trees, so CALL total on each of them.", "IF node IS NOTHING, RETURN 0; otherwise RETURN NODE VALUE PLUS the totals of LEFT and RIGHT.", "Both branches matter, even when the LEFT one is missing."],
  "validators": {"output": "equal"},
