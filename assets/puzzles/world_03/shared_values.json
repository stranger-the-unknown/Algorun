{
  "id": "shared_values",
  "version": 1,
  "title": "Shared Values",
  "world": "world_03",
  "chapter": "count_shared_distinct",
  "tier": 2,
  "mode": "edge",
  "concepts": [
    "hash_map"
  ],
  "prerequisites": [],
  "story": "Two stalls list item codes, each with its own repeats. How many different codes appear on both stalls? A code that shows up three times on each stall is still one shared code.",
  "io": {
    "inputs": [
      {
        "name": "left",
        "type": "array<num>"
      },
      {
        "name": "right",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "repeats on both sides",
      "no shared code",
      "an empty stall"
    ]
  },
  "blocks": {
    "allow": [
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "new.set",
      "set.add",
      "set.has",
      "set.size",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 33
  },
  "limits": {
    "maxOps": 119,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Put one stall's codes into a set so repeats collapse.",
    "Walk the other stall and collect the codes that the set already holds, again in a set.",
    "The size of that second set is the answer. Counting every copy would over-count."
  ],
  "validators": {
    "output": "equal"
  },
