{
  "id": "pair_sum_count",
  "version": 1,
  "title": "Pair Tickets",
  "world": "world_03",
  "chapter": "count_pairs_with_sum",
  "tier": 3,
  "mode": "optimize",
  "concepts": [
    "hash_map"
  ],
  "prerequisites": [],
  "story": "A booth sells tickets whose prices are listed with repeats. How many pairs of tickets, from two different positions, add up to the target price? Order does not matter, and a ticket cannot pair with itself. A price that appears twice can pair with itself only by using both copies.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      },
      {
        "name": "target",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a value pairing with itself",
      "repeated prices",
      "checking every pair of positions is over budget"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.eq",
      "ctrl.else",
      "ctrl.for_range",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "logic.is_nothing",
      "map.get",
      "map.set",
      "new.map",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 54
  },
  "limits": {
    "maxOps": 3292,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true,
    "baselineFactor": 8
  },
  "hints": [
    "As you read each price, ask how many earlier prices would complete the target.",
    "A map from price to how many times it has already been seen answers that in one look.",
    "Count the earlier copies before you record the price you are on, or a ticket pairs with itself."
  ],
  "validators": {
    "output": "equal"
  },
