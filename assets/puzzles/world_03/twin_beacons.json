{
  "id": "twin_beacons",
  "version": 1,
  "title": "Twin Beacons",
  "world": "world_03",
  "chapter": "complement",
  "tier": 2,
  "mode": "budget",
  "concepts": ["hash_set", "complement_lookup"],
  "prerequisites": ["arrays"],
  "story": "The harbour's beacons report their strength one after another. Two beacons resonate when their strengths add up to exactly the tuning number, and a beacon can never resonate with itself. The harbour master wants the position, counting from 0, of the first beacon that completes a resonant pair with any beacon logged before it. If no beacon ever does, report -1. The log can be long, and the harbour computer counts every step.",
  "io": {
    "inputs": [
      {"name": "strengths", "type": "array<num>"},
      {"name": "tuning", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 2000},
    "notes": ["Strengths are whole numbers from -1,000,000 to 1,000,000.", "Positions count from 0."]
  },
  "blocks": {"allow": ["ctrl.for_range", "ctrl.if", "ctrl.return", "var.set", "var.get", "lit.num", "arr.get", "arr.len", "arith.add", "arith.sub", "cmp.eq", "new.set", "set.add", "set.has"], "maxBlocks": 30},
  "limits": {"maxOps": 60000, "maxDepth": 32, "maxAlloc": 4000},
  "scoring": {"blockBudget": 30},
  "hints": ["Comparing every pair of beacons gives the right answer, but the long logs make it far too slow. Try to walk the log only once.", "At any beacon, only one strength could complete a pair with it: the tuning number minus its own strength. Keep a set of the strengths you have already passed.", "At each position, first ask the set whether the missing strength is already there; if it is, that position is your answer. Only after asking, add this beacon's strength. The order of those two steps matters."],
  "validators": {"output": "equal"},
