    "inputs": [
      {"name": "values", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 2000},
    "notes": ["Tokens are whole numbers from -5,000 to 5,000."]
  },
  "blocks": {"allow": ["arith.add", "arith.max", "arith.sub", "arr.append", "arr.get", "arr.len", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.not", "new.array", "new.set", "set.add", "set.has", "var.get", "var.inc", "var.set"], "maxBlocks": 56},
  "limits": {"maxOps": 120000, "maxDepth": 32, "maxAlloc": 6000},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["Put every number in a set, so asking 'is 7 in the box?' costs one step.", "Walking upward from every number finds every streak, but a long streak is then walked again from each of its members.", "Only start walking from a number whose predecessor is not in the box: it is the first of its streak."],
