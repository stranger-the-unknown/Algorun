  "concepts": ["hash_map", "prefix_sum"],
  "prerequisites": ["arrays", "prefix_sum"],
  "story": "A wall is built from rows of planks laid end to end. Every row is equally wide, but the planks in it are not. A carpenter saws straight down through the wall, from top to bottom, somewhere strictly between its two ends. Where the cut runs exactly along the joint between two planks, that row is not damaged; otherwise the saw goes through one plank of it. What is the fewest planks one cut must saw through? Planks can be very wide, so trying every place across the wall is too slow.",
  "io": {
    "inputs": [
      {"name": "rows", "type": "array<array<num>>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 60},
    "notes": ["1 to 60 rows, each of 1 to 20 planks; a plank is 1 to 3000 wide.", "Every row has the same total width."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.gt", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "logic.is_not_nothing", "logic.is_nothing", "map.get", "map.has", "map.set", "new.map", "var.get", "var.set"],
    "maxBlocks": 76
  },
  "limits": {"maxOps": 31700, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["A row is spared when the cut runs along one of its joints. So look for the place where the most rows have a joint.", "A joint's place is the total width of the planks before it. Walk each row with a running total and count each joint in a map. Leave out the end of the last plank: that is the wall's edge, not a joint.", "Keep the highest count you have seen. The answer is the number of rows MINUS that count. In a wall where no row has a joint, every row is sawn."],
