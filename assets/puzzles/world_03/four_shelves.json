      {"name": "sides", "type": "array<num>"},
      {"name": "desserts", "type": "array<num>"},
      {"name": "target", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 25},
    "notes": ["0 to 25 items on each shelf, prices from 1 to 40.", "The target is 1 to 200."]
  },
