{
  "id": "same_value_span",
  "version": 1,
  "title": "Same Value Span",
  "world": "world_03",
  "chapter": "widest_equal_span",
  "tier": 3,
  "mode": "budget",
  "concepts": [
    "hash_map"
  ],
  "prerequisites": [],
  "story": "Beacons blink a code, one after another. The span of a code is the distance from its first blink to a later blink of the same code. Report the widest such span. If no code repeats, report -1.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "no repeat",
      "the widest pair is not two neighbours",
      "comparing every pair is over budget"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.eq",
      "cmp.gt",
      "ctrl.else",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "logic.is_nothing",
      "map.get",
      "map.set",
      "new.map",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 48
  },
  "limits": {
    "maxOps": 1312,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true
  },
  "hints": [
    "Remember the first position of each code.",
    "When a code appears again, the span is the current position minus that first position.",
    "Keep the widest span. Comparing every pair of positions is too slow."
  ],
  "validators": {
    "output": "equal"
  },
