{
  "id": "fuel_loop",
  "version": 1,
  "title": "Fuel Loop",
  "world": "world_11",
  "chapter": "circuit_start_reset",
  "tier": 4,
  "mode": "build",
  "concepts": ["greedy"],
  "prerequisites": ["arrays"],
  "story": "Fuel stations stand around a circular road. At station i a car can take on fuel[i] units, and driving on to the next station burns cost[i] units. The tank starts empty and may never run below zero. From which station can the car complete one full lap? If several work, report the lowest-numbered; if none does, report -1. A long road must be checked within budget.",
  "io": {
    "inputs": [
      {"name": "fuel", "type": "array<num>"},
      {"name": "cost", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 2000},
    "notes": ["fuel and cost have the same length.", "Amounts are whole numbers from 0 to 40."]
  },
  "blocks": {"allow": ["arith.add", "arith.mod", "arith.sub", "arr.get", "arr.len", "cmp.ge", "cmp.lt", "ctrl.break", "ctrl.for_range", "ctrl.if", "ctrl.return", "lit.bool", "lit.num", "var.get", "var.set"], "maxBlocks": 57},
  "limits": {"maxOps": 100000, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["Simulating a lap from every station is correct, but on a long road it is far too slow.", "If the total fuel is less than the total cost, no start works. Otherwise some start does.", "Drive once from station 0 keeping the tank. If it ever drops below zero after station i, no station from the start up to i can be the answer: restart from i + 1 with an empty tank."],
  "validators": {"output": "equal"},
