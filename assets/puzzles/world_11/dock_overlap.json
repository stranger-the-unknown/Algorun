{
  "id": "dock_overlap",
  "version": 1,
  "title": "Dock Overlap",
  "world": "world_11",
  "chapter": "max_overlap_two_pointers",
  "tier": 3,
  "mode": "edge",
  "concepts": [
    "greedy"
  ],
  "prerequisites": [],
  "story": "Ships have arrival times and departure times, each list already sorted, lowest first. A ship occupies a berth from its arrival up to but not including its departure. What is the largest number of ships in berth at the same moment? No ships is 0.",
  "io": {
    "inputs": [
      {
        "name": "starts",
        "type": "array<num>"
      },
      {
        "name": "ends",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a departure at the same minute does not overlap that arrival",
      "no ships",
      "every ship overlaps"
    ]
  },
  "blocks": {
    "allow": [
      "arr.get",
      "arr.len",
      "cmp.gt",
      "cmp.le",
      "cmp.lt",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.and",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 51
  },
  "limits": {
    "maxOps": 318,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Walk the two sorted lists. An arrival increases the count; a departure decreases it.",
    "When an arrival and a departure share a minute, the departure happens first, so that ship is already gone.",
    "The answer is the highest count you see."
  ],
  "validators": {
    "output": "equal"
  },
