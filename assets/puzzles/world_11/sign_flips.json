  "concepts": ["greedy"],
  "prerequisites": [],
  "story": "A ledger lists gains and losses, sorted from the lowest number to the highest. An auditor must flip the sign of an entry exactly k times in all; she may pick the same entry more than once, and every flip counts. What is the largest total the ledger can show afterwards? With entries -4 -2 7 and k = 3: -4 and -2 become 4 and 2, and the third flip still has to go somewhere. It costs least on the 2, for a total of 9.",
  "io": {
    "inputs": [
      {"name": "ledger", "type": "array<num>"},
      {"name": "k", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 200},
    "notes": ["1 to 200 entries from -1000 to 1000, lowest first.", "k is 0 to 1000."]
  },
  "blocks": {
    "allow": ["arith.abs", "arith.add", "arith.max", "arith.min", "arith.mod", "arith.mul", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "cmp.ne", "ctrl.break", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "logic.not", "logic.or", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 85
  },
  "limits": {"maxOps": 10900, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Flipping a loss into a gain always helps, and the biggest losses come first in the ledger. Flipping the same entry twice changes nothing.", "Walk the ledger: while flips are left and the entry is negative, flip it. Whatever flips remain after that can be spent two at a time on any entry without changing the total.", "IF an odd number of flips is left over (REMAINDER 2 is 1), one entry must end up flipped: pick the one closest to zero, the MIN of the ABSOLUTE values, and subtract it twice from the total."],
  "validators": {"output": "equal"},
