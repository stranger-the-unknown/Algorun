{
  "id": "cookie_gifts",
  "version": 1,
  "title": "Cookie Gifts",
  "world": "world_11",
  "chapter": "assign_sorted_cookies",
  "tier": 2,
  "mode": "build",
  "concepts": [
    "greedy"
  ],
  "prerequisites": [],
  "story": "Children and cookies are both listed smallest first. A child is content with any cookie at least as big as their appetite. Each cookie feeds at most one child. How many children can be content?",
  "io": {
    "inputs": [
      {
        "name": "children",
        "type": "array<num>"
      },
      {
        "name": "cookies",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a cookie too small must be skipped, not given up on",
      "no cookies",
      "every child fed"
    ]
  },
  "blocks": {
    "allow": [
      "arr.get",
      "arr.len",
      "cmp.ge",
      "cmp.lt",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.and",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 43
  },
  "limits": {
    "maxOps": 192,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Offer the smallest remaining cookie to the smallest child still waiting.",
    "If it is too small, that cookie cannot feed any later child either, because later children want at least as much. Skip the cookie.",
    "If it fits, both the child and the cookie are used."
  ],
  "validators": {
    "output": "equal"
  },
