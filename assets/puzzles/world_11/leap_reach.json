{
  "id": "leap_reach",
  "version": 1,
  "title": "Leap Reach",
  "world": "world_11",
  "chapter": "jump_game_reach",
  "tier": 3,
  "mode": "edge",
  "concepts": [
    "greedy"
  ],
  "prerequisites": [],
  "story": "Stones stand in a line. The number on a stone is the longest leap you may make from it: you may move forward any number of stones from 1 up to that number, so a stone showing 0 lets you go nowhere. You start on the first stone. Report whether you can reach the last stone. A single stone is already reached.",
  "io": {
    "inputs": [
      {
        "name": "jumps",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a zero leap before the end",
      "stepping past a gap you never reached",
      "one stone"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.max",
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.eq",
      "cmp.ge",
      "cmp.gt",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.bool",
      "lit.num",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 50
  },
  "limits": {
    "maxOps": 190,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Keep the farthest index you can reach so far.",
    "If your index is beyond that farthest reach, you are stuck.",
    "From a stone you can stand on, the new reach is the index plus the leap."
  ],
  "validators": {
    "output": "equal"
  },
