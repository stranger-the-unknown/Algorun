{
  "id": "josephus_line",
  "version": 1,
  "title": "Counting Out",
  "world": "world_06",
  "chapter": "counting_out_queue",
  "tier": 3,
  "mode": "build",
  "concepts": [
    "queue"
  ],
  "prerequisites": [],
  "story": "n people, numbered 1 to n, stand in a circle in that order; n is the input people. Count k people from the front, where k is the input count: the k-th person leaves, and the count continues with the next person. Report the number of the last person still standing. Both inputs are at least 1.",
  "io": {
    "inputs": [
      {
        "name": "people",
        "type": "num"
      },
      {
        "name": "count",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "k is 1, so people leave in order and the last number remains",
      "n is 1",
      "the last original person is not always the survivor"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.sub",
      "cmp.gt",
      "ctrl.for_range",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "new.queue",
      "queue.deq",
      "queue.enq",
      "queue.front",
      "var.dec",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 44
  },
  "limits": {
    "maxOps": 349,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "A queue can be the circle: the front is who you are counting now.",
    "To skip someone, take them off the front and send them to the back.",
    "The k-th person leaves and does not rejoin. When one person remains, they are the answer."
  ],
  "validators": {
    "output": "equal"
  },
