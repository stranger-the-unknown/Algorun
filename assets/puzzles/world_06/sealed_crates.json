{
  "id": "sealed_crates",
  "version": 1,
  "title": "Sealed Crates",
  "world": "world_06",
  "chapter": "matching_pairs_stack",
  "tier": 2,
  "mode": "build",
  "concepts": ["stack"],
  "prerequisites": ["arrays"],
  "story": "Crates nest inside each other in a shipping yard. A packing log lists every action: a positive number k opens a crate of kind k, and -k seals the most recently opened crate that is still open, which must be of kind k. Is the log a correct packing, with every crate sealed in the right order and nothing left open?",
  "io": {
    "inputs": [
      {"name": "codes", "type": "array<num>"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 700},
    "notes": ["Kinds are 1, 2 or 3; no action is 0."]
  },
  "blocks": {"allow": ["arith.sub", "cmp.eq", "cmp.gt", "cmp.lt", "cmp.ne", "ctrl.else", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.bool", "lit.num", "logic.not", "new.stack", "stack.empty", "stack.peek", "stack.pop", "stack.push", "var.dec", "var.get", "var.inc", "var.set"], "maxBlocks": 39},
  "limits": {"maxOps": 20000, "maxDepth": 32, "maxAlloc": 1000},
  "hints": ["Only the most recently opened crate can be sealed next.", "Keep the open crates on a stack. Opening pushes; sealing must match the kind on top.", "Sealing with nothing open is wrong, and so is a crate left open at the end. Counting opens and seals is not enough: the kinds matter."],
  "validators": {"output": "equal"},
