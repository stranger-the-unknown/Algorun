{
  "id": "stack_sorted",
  "version": 1,
  "title": "Stack Sorted",
  "world": "world_06",
  "chapter": "stack_permutation_123",
  "tier": 3,
  "mode": "edge",
  "concepts": [
    "stack"
  ],
  "prerequisites": [],
  "story": "Wagons numbered 1, 2, 3, and so on arrive in that order. A siding is a stack: you may push the next wagon on, or pop the top wagon into the outgoing line. The wanted line is a rearrangement of 1 through n. Report whether that line can be built. An empty wanted line can.",
  "io": {
    "inputs": [
      {
        "name": "want",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "only the already sorted order is accepted by a careless check",
      "a reversal",
      "an empty line"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arr.get",
      "arr.len",
      "cmp.eq",
      "cmp.lt",
      "cmp.ne",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.bool",
      "lit.num",
      "logic.and",
      "logic.not",
      "new.stack",
      "stack.empty",
      "stack.peek",
      "stack.pop",
      "stack.push",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 50
  },
  "limits": {
    "maxOps": 320,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Push wagons in order, and after each push pop while the top is the next wagon the line wants.",
    "Never push out of order, and never pop a wagon that is not the next wanted one if a later one is still required first.",
    "If every wanted wagon leaves, the line is possible."
  ],
  "validators": {
    "output": "equal"
  },
  "fixtures": {
    "visible": [
      {
        "id": "v1",
        "in": {
          "want": []
        },
        "out": true
      },
      {
        "id": "v2",
        "in": {
          "want": [
            1
          ]
        },
        "out": true
      }
    ],
    "hidden": [
      {
        "id": "h01",
        "in": {
          "want": [
            2,
            1
          ]
        },
        "out": true
      },
      {
        "id": "h02",
        "in": {
          "want": [
            3,
            2,
            1
          ]
        },
        "out": true
      },
      {
        "id": "h03",
        "in": {
          "want": [
            2,
            1,
            3
          ]
        },
        "out": true
      },
      {
        "id": "h04",
        "in": {
          "want": [
            1,
            3,
            2
          ]
        },
        "out": true
      },
      {
        "id": "h05",
        "in": {
          "want": [
            1,
            3,
            2,
            4
          ]
        },
        "out": true
      },
      {
        "id": "h06",
        "in": {
          "want": [
            2,
            1,
            4,
            5,
            3
          ]
        },
        "out": true
      }
    ]
  },
  "edgeCases": [
    "only the already sorted order is accepted by a careless check",
    "a reversal",
    "an empty line"
  ],
  "variables": {
    "pool": [
      {
        "name": "x",
        "type": "num"
      },
      {
        "name": "i",
        "type": "num"
      },
      {
        "name": "n",
        "type": "num"
      },
      {
        "name": "st",
        "type": "stack<num>"
      },
      {
        "name": "gone",
        "type": "num"
      },
      {
        "name": "ok",
        "type": "bool"
      }
    ]
  },
  "reference": {
    "strategy": "stack_permutation_123"
  }
}
