  "prerequisites": ["arrays"],
  "story": "A note-taking app scores a note by adding up the lengths of the words in it. Each action in the log is either a positive number, typing a word of that length at the end, or 0, pressing UNDO, which removes the most recent word still in the note. Pressing UNDO on an empty note does nothing. What is the note's score after the last action?",
  "io": {
    "inputs": [
      {"name": "actions", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 600},
    "notes": ["Word lengths are whole numbers from 1 to 9."]
  },
  "blocks": {"allow": ["arith.add", "arith.sub", "cmp.eq", "cmp.gt", "ctrl.else", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "logic.not", "new.stack", "stack.empty", "stack.peek", "stack.pop", "stack.push", "var.get", "var.set"], "maxBlocks": 39},
  "limits": {"maxOps": 10000, "maxDepth": 32, "maxAlloc": 1000},
  "hints": ["UNDO always removes the latest word that is still there, so the words behave like a stack.", "Keep a running score: add when a word is typed, subtract the word that UNDO takes back.", "Before taking a word back, make sure there is one. An UNDO on an empty note must change nothing."],
  "validators": {"output": "equal"},
