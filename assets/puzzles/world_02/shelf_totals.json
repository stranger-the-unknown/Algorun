  "concepts": ["arrays", "prefix_sum"],
  "prerequisites": ["variables"],
  "story": "A warehouse aisle is a row of shelves, each holding a count of items (a damaged-goods shelf counts as negative). Clerks ask many questions of the form 'how many items from shelf a to shelf b, both included?'. Question k runs from starts[k] to ends[k]. Answer every question, in order. The aisle is long and the questions keep coming, and the warehouse computer counts every step.",
  "io": {
    "inputs": [
      {"name": "values", "type": "array<num>"},
      {"name": "starts", "type": "array<num>"},
      {"name": "ends", "type": "array<num>"}
    ],
    "output": {"type": "array<num>"}
  },
  "constraints": {
    "n": {"min": 1, "max": 1500},
    "notes": ["Shelves count from 0.", "Every question has 0 <= start <= end < number of shelves.", "There are as many starts as ends, at most 1,500."]
  },
  "blocks": {"allow": ["arith.add", "arith.sub", "arr.append", "arr.get", "arr.len", "ctrl.for_range", "ctrl.foreach", "ctrl.return", "lit.num", "new.array", "var.get", "var.set"], "maxBlocks": 51},
  "limits": {"maxOps": 60000, "maxDepth": 32, "maxAlloc": 8000},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["Adding up the shelves again for every question is correct, but long questions on a long aisle take far too many steps.", "Walk the aisle once and write down the running total before each shelf: the total of the first 0 shelves, the first 1, the first 2, and so on.", "The items from shelf a to shelf b are the running total up to b minus the running total before a. With a 0 at the front of the list, that is list[b + 1] - list[a]."],
  "validators": {"output": "equal"},
