  "concepts": ["arrays"],
  "prerequisites": [],
  "story": "In a theatre, prices never fall as you move right along a row, and never fall as you move back from one row to the next. The grid lists the prices row by row, front row first. How many seats cost at most the budget? Checking every seat is too slow for a big hall.",
  "io": {
    "inputs": [
      {"name": "prices", "type": "array<array<num>>"},
      {"name": "budget", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 200},
    "notes": ["1 to 30 rows, each with the same number of seats, 1 to 200.", "Equal prices next to each other are allowed."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.floor_div", "arith.sub", "arr.get", "arr.len", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "var.get", "var.set"],
    "maxBlocks": 72
  },
  "limits": {"maxOps": 10000, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 2},
  "hints": ["Stand at the last seat of the front row. If it is affordable, so is every seat to its left in that row.", "If that seat is too dear, every seat behind it in the same column is too dear as well, so the whole column can be forgotten.", "Keep a row r and a column c. WHILE both are inside the hall: IF the seat costs at most the budget, add c PLUS 1 to the count and go to the next row, ELSE move one column to the left."],
