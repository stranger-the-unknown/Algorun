{
  "id": "second_highest",
  "version": 1,
  "title": "Second Highest",
  "world": "world_02",
  "chapter": "strict_second_maximum",
  "tier": 2,
  "mode": "edge",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "A judge wants the second-highest distinct score on a board. Equal top scores do not create a runner-up: 9 and 9 still need some lower score to be second. If there is no strictly smaller score, report -1. Fewer than two distinct scores is -1.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a repeated peak is not second",
      "all scores equal",
      "negatives",
      "the runner-up is the last score"
    ]
  },
  "blocks": {
    "allow": [
      "cmp.eq",
      "cmp.ge",
      "cmp.gt",
      "cmp.lt",
      "ctrl.else",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "logic.and",
      "logic.or",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 68
  },
  "limits": {
    "maxOps": 1423,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Keep the best score and a separate runner-up, and update the runner-up when the best changes.",
    "A score equal to the best is not a new runner-up.",
    "If every score is the same, there is no second place."
  ],
  "validators": {
    "output": "equal"
  },
  "fixtures": {
    "visible": [
      {
        "id": "v1",
        "in": {
