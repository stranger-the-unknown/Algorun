  "prerequisites": [],
  "story": "A band plays the same songs every night, each night in the next order of a fixed sequence. Orders are ranked like words in a dictionary: compare the first song number, then the second, and so on. Given tonight's order, report tomorrow's: the smallest order that ranks after it. After the very last order, the band starts again from the first one, with the numbers rising. A song number may appear more than once.",
  "io": {
    "inputs": [
      {"name": "order", "type": "array<num>"}
    ],
    "output": {"type": "array<num>"}
  },
  "constraints": {
    "n": {"min": 1, "max": 60},
    "notes": ["1 to 60 songs, numbers from 1 to 99.", "Tomorrow's order uses exactly the same songs."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "arr.set", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "var.get", "var.set"],
    "maxBlocks": 152
  },
  "limits": {"maxOps": 30000, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Change as little as possible, as far to the right as possible. Coming from the right, find the first song that is smaller than the song right after it.", "That song must grow, but only just: swap it with the rightmost song that is bigger than it. Everything after that position is still in falling order.", "Finally reverse everything after that position, so the tail rises. If no such song exists, tonight's order was the last one: reverse the whole list. With equal numbers, an equal song is neither smaller nor bigger."],
  "validators": {"output": "equal"},
