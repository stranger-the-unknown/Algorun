{
  "id": "high_water_marks",
  "version": 1,
  "title": "High-Water Marks",
  "world": "world_02",
  "chapter": "running_maximum_list",
  "tier": 2,
  "mode": "complete",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "A river gauge is read once a day. For every day, the harbour master writes down the highest level seen so far, that day included. Levels are 0 or more. Return the list of those marks, one per day. The program already writes a mark for each day, but its marks never rise.",
  "io": {
    "inputs": [
      {
        "name": "levels",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "array<num>"
    }
  },
  "constraints": {
    "notes": [
      "There are 0 to 60 days.",
      "Each level is a whole number from 0 to 100."
    ]
  },
  "blocks": {
    "allow": [
      "arr.append",
      "cmp.gt",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "new.array",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 26
  },
  "limits": {
    "maxOps": 250,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "The program writes one mark per day, and the mark is always best. Nothing ever changes best.",
    "Before a day's mark is written, check whether that day's level beats the best so far.",
    "Inside FOR EACH, above APPEND: IF level is GREATER THAN best, SET best to level."
  ],
  "validators": {
    "output": "equal"
  },
