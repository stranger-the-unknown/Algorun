  "title": "Balance Point",
  "world": "world_02",
  "chapter": "first_balance_index",
  "tier": 3,
  "mode": "budget",
  "concepts": ["arrays", "prefix_sum"],
  "prerequisites": [],
  "story": "Crates stand in a row on a long plank. The plank balances on a crate when the crates to its left weigh exactly as much as the crates to its right; the crate itself counts for neither side, and an empty side weighs 0. Report the position, counting from 0, of the first crate the plank balances on, or -1 if there is none. Adding up both sides again for every crate takes too many steps for the longest rows.",
  "io": {
    "inputs": [
      {"name": "weights", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 2001},
    "notes": ["Crates weigh 0 to 100, except that a row may end with one very heavy crate."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "cmp.eq", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "var.get", "var.set"],
    "maxBlocks": 55
  },
  "limits": {"maxOps": 88050, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["The weight on the right is the total, minus the left side, minus the crate itself.", "Add everything up once, then walk from the left keeping the weight of the left side.", "Check the balance before you add the current crate to the left side; the first crate has an empty left side."],
  "validators": {"output": "equal"},
