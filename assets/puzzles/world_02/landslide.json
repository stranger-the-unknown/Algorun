  "concepts": ["arrays"],
  "prerequisites": [],
  "story": "Each ballot names one candidate by their registration number. A candidate wins outright only with more than half of all the ballots. Report the outright winner, or 0 if nobody has more than half. Registration numbers run into the hundreds of thousands, and tallying every ballot against every other ballot takes too many steps for the largest elections.",
  "io": {
    "inputs": [
      {"name": "ballots", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 3000},
    "notes": ["Registration numbers are whole numbers from 1 to 999999."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.mul", "arr.get", "arr.len", "cmp.eq", "cmp.ge", "cmp.gt", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 68
  },
  "limits": {"maxOps": 93000, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["Pair off ballots for different candidates and cancel them: a candidate with more than half always survives the cancelling.", "Keep one candidate and a counter: a ballot for the kept candidate adds 1, any other takes 1 away, and at 0 the next ballot becomes the new kept candidate.", "Surviving is not enough: count the kept candidate's ballots in a second pass and check it really has more than half."],
  "validators": {"output": "equal"},
