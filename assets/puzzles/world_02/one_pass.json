{
  "id": "one_pass",
  "version": 1,
  "title": "One Pass",
  "world": "world_02",
  "chapter": "count_swaps_single_bubble_pass",
  "tier": 2,
  "mode": "predict",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "A sorting robot walks once along a row of numbered crates, from left to right. The program is its rule book, and what it returns is a count. Read the program and say what it returns for each row of crates.",
  "io": {
    "inputs": [
      {
        "name": "crates",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "notes": [
      "There are 0 to 40 crates.",
      "Each crate number is a whole number from 0 to 99."
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.sub",
      "arr.get",
      "arr.len",
      "arr.swap",
      "cmp.gt",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 41
  },
  "limits": {
    "maxOps": 250,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "Write the row down and change it as the program does: a SWAP changes what the next comparison sees.",
    "After a SWAP the larger crate has moved one place to the right, and it is compared again on the next trip.",
    "For 2, 1, 3: 2 and 1 change places (one swap), then 2 and 3 stay. The program returns 1."
  ],
  "validators": {
    "output": "equal"
  },
