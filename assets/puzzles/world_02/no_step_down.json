{
  "id": "no_step_down",
  "version": 1,
  "title": "No Step Down",
  "world": "world_02",
  "chapter": "non_decreasing_check",
  "tier": 2,
  "mode": "repair",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "A stair builder lists the height of every step, from the bottom up. The stairs are fine when no step is lower than the step before it; two steps of the same height are allowed. The program should answer TRUE for fine stairs and FALSE for the others, but it turns some fine stairs away. Find the mistake and fix it.",
  "io": {
    "inputs": [
      {
        "name": "heights",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "notes": [
      "There are 0 to 60 steps.",
      "Each height is a whole number from 0 to 100."
    ]
  },
  "blocks": {
    "allow": [
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.le",
      "cmp.lt",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.bool",
      "lit.num",
      "var.get"
    ],
    "maxBlocks": 27
  },
  "limits": {
    "maxOps": 200,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "Look at the case the program gets wrong: which two steps does it complain about?",
    "Two steps of the same height are allowed. What does the IF do when both heights are equal?",
    "The comparison is too strict: a step is only wrong when it is LESS THAN the one before it, not LESS OR EQUAL."
  ],
  "validators": {
    "output": "equal"
  },
