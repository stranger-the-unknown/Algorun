{
  "id": "nested_distinct",
  "version": 1,
  "title": "Nested Distinct",
  "world": "world_02",
  "chapter": "nested_distinct_count",
  "tier": 2,
  "mode": "restricted",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "A shelf lists item codes, with repeats. Report how many different codes appear. Memory is scarce: you may not keep a set or a map of the codes you have already seen. Looking back through the list is allowed.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "all duplicates",
      "empty shelf",
      "a set of every code runs out of memory on a long shelf"
    ]
  },
  "blocks": {
    "allow": [
      "arr.get",
      "arr.len",
      "cmp.eq",
      "ctrl.for_range",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "new.set",
      "set.add",
      "set.size",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 40
  },
  "limits": {
    "maxOps": 568,
    "maxDepth": 64,
    "maxAlloc": 4
  },
  "hints": [
    "A code is new when no earlier position holds the same code.",
    "Count it only the first time it appears.",
    "A set would remember the codes, but this shelf does not give you that much memory."
  ],
  "validators": {
    "output": "equal"
  },
  "fixtures": {
    "visible": [
      {
        "id": "v1",
        "in": {
          "values": [
            3,
