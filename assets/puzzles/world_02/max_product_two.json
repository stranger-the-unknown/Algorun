  "tier": 3,
  "mode": "optimize",
  "concepts": [
    "arrays"
  ],
  "prerequisites": [],
  "story": "Two speakers are chosen from a row of volumes, which may be negative. Their combined loudness is the product of the two volumes. Report the largest product any two different speakers can make. Fewer than two speakers is 0.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "two negatives beat two positives",
      "fewer than two speakers",
      "comparing every pair is over budget"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.max",
      "arith.mul",
      "arr.get",
      "arr.len",
      "cmp.gt",
      "cmp.lt",
      "ctrl.else",
      "ctrl.for_range",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 67
  },
  "limits": {
    "maxOps": 1256,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true,
    "baselineFactor": 8
  },
  "hints": [
    "The best pair is either the two largest volumes or the two most negative ones.",
    "Keep the two largest and the two smallest as you walk the row once.",
    "Comparing every pair is correct and far too slow for a long row."
  ],
  "validators": {
    "output": "equal"
  },
