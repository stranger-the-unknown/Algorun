{
  "id": "rod_triangles",
  "version": 1,
  "title": "Rod Triangles",
  "world": "world_04",
  "chapter": "count_pairs_above_fixed_longest",
  "tier": 4,
  "mode": "budget",
  "concepts": ["two_pointers"],
  "prerequisites": [],
  "story": "A workshop rack holds rods sorted from shortest to longest; lengths may repeat. Three rods can be joined into a triangle only when the two shorter ones together are strictly longer than the longest. How many different sets of three rods make a triangle? Rods at different positions are different rods, even when they are equally long. Testing every set of three is too slow for a full rack.",
  "io": {
    "inputs": [
      {"name": "rods", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 80},
    "notes": ["0 to 80 rods, lengths from 1 to 400, never decreasing along the rack."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "var.get", "var.set"],
    "maxBlocks": 72
  },
  "limits": {"maxOps": 450000, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 2},
  "hints": ["Fix the longest rod of the three. Now you need pairs among the rods before it whose lengths add up to more than it.", "Put one mark on the shortest rod and one just before the longest. If these two together are long enough, so is every rod between them paired with the upper one.", "In that case add (upper mark MINUS lower mark) to the count and move the upper mark down; otherwise move the lower mark up. Stop when the marks meet, then take the next longest rod."],
  "validators": {"output": "equal"},
