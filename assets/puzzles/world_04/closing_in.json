  "concepts": [
    "two_pointers"
  ],
  "prerequisites": [],
  "story": "Two markers start at the two ends of a row of numbered cards and walk toward each other. The program is their rule book. Read it and say what it returns for each row. There is always at least one card.",
  "io": {
    "inputs": [
      {
        "name": "cards",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "notes": [
      "There are 1 to 40 cards.",
      "Each card is a whole number from 0 to 99."
    ]
  },
  "blocks": {
    "allow": [
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.lt",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 38
  },
  "limits": {
    "maxOps": 250,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "Keep two fingers on the row, one for lo and one for hi, and move one finger per trip through WHILE.",
    "Each trip, the marker on the smaller card moves. When the two cards are equal, hi moves.",
    "Which card can a marker never walk away from? The loop ends with both markers standing on it."
  ],
  "validators": {
    "output": "equal"
  },
