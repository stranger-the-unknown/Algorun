{
  "id": "mirror_shelf",
  "version": 1,
  "title": "Mirror Shelf",
  "world": "world_04",
  "chapter": "mirror_check_from_both_ends",
  "tier": 2,
  "mode": "complete",
  "concepts": [
    "two_pointers"
  ],
  "prerequisites": [],
  "story": "A shop window shelf looks right when it reads the same from both ends: the first item matches the last, the second matches the second to last, and so on. The items are given as numbers. Return TRUE when the shelf is a mirror of itself. The program already walks two markers toward each other; where the second marker starts, and what is checked at each stop, are missing.",
  "io": {
    "inputs": [
      {
        "name": "items",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "notes": [
      "There are 0 to 60 items.",
      "Each item is a whole number from 0 to 9."
    ]
  },
  "blocks": {
    "allow": [
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.lt",
      "cmp.ne",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.bool",
      "lit.num",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 38
  },
  "limits": {
    "maxOps": 200,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "lo starts on the first item. Where must hi start so that it points at the last one?",
    "Each trip through WHILE looks at one pair: the item at lo and the item at hi. One pair that differs settles the answer.",
    "SET hi to LENGTH of items MINUS 1. Inside WHILE, above the two moves: IF the item at lo is NOT EQUAL to the item at hi, RETURN FALSE."
  ],
  "validators": {
    "output": "equal"
  },
