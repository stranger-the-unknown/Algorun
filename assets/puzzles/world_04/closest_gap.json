{
  "id": "closest_gap",
  "version": 1,
  "title": "Closest Gap",
  "world": "world_04",
  "chapter": "closest_pair_sum_to_target",
  "tier": 4,
  "mode": "budget",
  "concepts": [
    "two_pointers"
  ],
  "prerequisites": [],
  "story": "A sorted row of numbers, lowest first, must supply two different positions. Their sum should be as close as possible to the target. Report how far the best sum is from the target — the absolute difference, never negative. There are at least two numbers.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      },
      {
        "name": "target",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "the closest sum is not a neighbour pair",
      "an exact hit has distance 0",
      "every pair is over budget"
    ]
  },
  "blocks": {
    "allow": [
      "arith.abs",
      "arith.add",
      "arith.min",
      "arith.sub",
      "arr.get",
      "arr.len",
      "cmp.lt",
      "ctrl.else",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 58
  },
  "limits": {
    "maxOps": 2743,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true
  },
  "hints": [
    "One mark starts at the left, one at the right.",
    "If the sum is too small, move the left mark; if it is too big, move the right mark.",
    "ABS gives the distance to the target. Checking every pair is too slow."
  ],
  "validators": {
    "output": "equal"
  },
