  "concepts": ["two_pointers"],
  "prerequisites": [],
  "story": "Two night guards each keep a list of their watches, earliest first; a guard's own watches never overlap or touch. The first guard's watch i runs from minute startsA[i] up to, but not including, minute endsA[i]; the second guard's lists, startsB and endsB, work the same way. For how many minutes in total are both guards on watch at the same time? Long lists must be finished within the operation budget.",
  "io": {
    "inputs": [
      {"name": "startsA", "type": "array<num>"},
      {"name": "endsA", "type": "array<num>"},
      {"name": "startsB", "type": "array<num>"},
      {"name": "endsB", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 150},
    "notes": ["0 to 150 watches for each guard, minutes from 0 to 6000.", "Inside one guard's lists every watch ends before the next one starts."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.sub", "arr.get", "arr.len", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "var.get", "var.set"],
    "maxBlocks": 98
  },
  "limits": {"maxOps": 27000, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["Look at one watch of each guard. They share the minutes from the later start to the earlier end, if that is a positive number.", "Keep one mark in each guard's list. After comparing the two watches, the one that ends first can share nothing with any later watch of the other guard.", "So move on from the watch that ends first and keep the other one: a long watch may overlap several short ones. Stop when either list runs out."],
  "validators": {"output": "equal"},
