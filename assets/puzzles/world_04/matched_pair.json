  "world": "world_04",
  "chapter": "opposite_ends_pair_sum",
  "tier": 2,
  "mode": "restricted",
  "concepts": ["two_pointers"],
  "prerequisites": ["arrays"],
  "story": "A rack of weights is sorted from lightest to heaviest; the scale reads negative for counterweights. Is there a pair of two different weights on the rack that together weigh exactly the target? The scale's computer has almost no memory: it cannot write down the weights it has seen.",
  "io": {
    "inputs": [
      {"name": "values", "type": "array<num>"},
      {"name": "target", "type": "num"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 120},
    "notes": ["Weights never decrease along the rack.", "Weights are whole numbers from -800 to 800."]
  },
  "blocks": {"allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.gt", "cmp.lt", "ctrl.else", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.bool", "lit.num", "new.set", "set.add", "set.has", "var.dec", "var.get", "var.inc", "var.set"], "maxBlocks": 45},
  "limits": {"maxOps": 5000, "maxDepth": 32, "maxAlloc": 4},
  "hints": ["Remembering every weight in a set would work, but this scale can hold only a handful of memory cells.", "Look at the lightest and the heaviest weight together. If they are too light, which of the two can never be part of an answer?", "Move one end inward at a time: too light moves the light end up, too heavy moves the heavy end down, and stop when the two ends meet."],
  "validators": {"output": "equal"},
