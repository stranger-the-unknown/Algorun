{
  "id": "far_from_zero",
  "version": 1,
  "title": "Far from Zero",
  "world": "world_04",
  "chapter": "merge_inward_by_distance",
  "tier": 3,
  "mode": "build",
  "concepts": ["two_pointers"],
  "prerequisites": [],
  "story": "A thermometer log is sorted from coldest to warmest and may hold readings below zero. Build a new list that says how far each reading is from zero, farthest first: -7 -2 1 4 becomes 7 4 2 1. A long log must be finished within the operation budget: searching the whole log again for every entry is too slow.",
  "io": {
    "inputs": [
      {"name": "log", "type": "array<num>"}
    ],
    "output": {"type": "array<num>"}
  },
  "constraints": {
    "n": {"min": 0, "max": 500},
    "notes": ["0 to 500 readings from -999 to 999, never decreasing along the log."]
  },
  "blocks": {
    "allow": ["arith.abs", "arith.add", "arith.sub", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "new.array", "var.get", "var.set"],
    "maxBlocks": 74
  },
  "limits": {"maxOps": 24050, "maxDepth": 32, "maxAlloc": 1050},
  "performance": {"required": true, "baselineFactor": 10},
  "hints": ["The reading farthest from zero is always at one of the two ends of the log: the coldest one or the warmest one.", "Keep one mark at each end. Compare the ABSOLUTE values under the two marks, APPEND the larger one to the new list, and move that mark inward.", "Go on WHILE the lower mark is LESS OR EQUAL to the upper mark, so the last reading in the middle is not forgotten."],
  "validators": {"output": "equal"},
