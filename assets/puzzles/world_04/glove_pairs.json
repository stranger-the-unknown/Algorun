{
  "id": "glove_pairs",
  "version": 1,
  "title": "Glove Pairs",
  "world": "world_04",
  "chapter": "count_matched_pairs_sorted_multisets",
  "tier": 3,
  "mode": "repair",
  "concepts": [
    "two_pointers"
  ],
  "prerequisites": [],
  "story": "Two boxes hold gloves, left ones in one box and right ones in the other. Every glove is marked with its size, and each box is sorted from small to large. A left glove pairs with a right glove of the same size, and a glove can be in one pair only. The program should count the pairs, but for some boxes it counts too many. Find the mistake and fix it.",
  "io": {
    "inputs": [
      {
        "name": "lefts",
        "type": "array<num>"
      },
      {
        "name": "rights",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "notes": [
      "Each box holds 0 to 40 gloves.",
      "Sizes are whole numbers from 1 to 20, sorted, and may repeat."
    ]
  },
  "blocks": {
    "allow": [
      "arr.get",
      "arr.len",
      "cmp.eq",
      "cmp.lt",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.and",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 59
  },
  "limits": {
    "maxOps": 650,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "The answer is too high only when a size appears more than once in a box. Follow the failing case by hand.",
    "When two gloves pair up, both are used. Does the program move on in both boxes?",
    "In the branch where the sizes are EQUAL the program moves i but not j: add INCREMENT j there."
  ],
  "validators": {
    "output": "equal"
  },
