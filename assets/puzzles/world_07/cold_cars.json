  "world": "world_07",
  "chapter": "linked_list_count_below",
  "tier": 2,
  "mode": "edge",
  "concepts": [
    "linked_list"
  ],
  "prerequisites": [],
  "story": "Each car carries a temperature. Count the cars whose temperature is strictly below the limit. A car exactly at the limit is not cold. An empty train has no cold cars.",
  "io": {
    "inputs": [
      {
        "name": "head",
        "type": "listNode?"
      },
      {
        "name": "limit",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a car exactly at the limit",
      "every car cold",
      "an empty train"
    ]
  },
  "blocks": {
    "allow": [
      "cmp.le",
      "cmp.lt",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "ll.next",
      "ll.value",
      "logic.is_not_nothing",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 30
  },
  "limits": {
    "maxOps": 148,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Walk NEXT NODE while the car IS NOT NOTHING.",
    "NODE VALUE is safe only inside that check.",
    "Count a car only when its temperature is strictly less than the limit."
  ],
  "validators": {
    "output": "equal"
  },
