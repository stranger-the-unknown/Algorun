  "story": "A clerk has a target car number and the head of a train. Report whether any car wears that number. The answer is yes or no. An empty train has no cars, so the answer is no.",
  "io": {
    "inputs": [
      {
        "name": "head",
        "type": "listNode?"
      },
      {
        "name": "target",
        "type": "num"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "the number is only on the last car",
      "the number is missing",
      "looking only at the first car"
    ]
  },
  "blocks": {
    "allow": [
      "cmp.eq",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.bool",
      "ll.next",
      "ll.value",
      "logic.is_not_nothing",
      "logic.is_nothing",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 29
  },
  "limits": {
    "maxOps": 128,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Walk the chain while the car IS NOT NOTHING.",
    "If NODE VALUE equals the target, you can answer yes immediately.",
    "If the walk ends, the answer is no."
  ],
  "validators": {
    "output": "equal"
  },
