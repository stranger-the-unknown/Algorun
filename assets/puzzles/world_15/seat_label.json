  "story": "A theatre prints a label for every seat: the row letter, a dash, and the seat number written with two digits. Seat 12 in row C is C-12, and seat 7 in row C is C-07. Given a row letter and a seat number from 1 to 99, return the label.",
  "io": {
    "inputs": [
      {"name": "row", "type": "str"},
      {"name": "seat", "type": "num"}
    ],
    "output": {"type": "str"}
  },
  "constraints": {"notes": ["row is one capital letter.", "seat is a whole number from 1 to 99."]},
  "blocks": {
    "allow": ["cmp.lt", "ctrl.if", "ctrl.return", "lit.num", "lit.str", "str.concat", "str.from_num", "var.get", "var.set"],
    "maxBlocks": 28,
    "texts": ["-", "0"]
  },
  "limits": {"maxOps": 100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["A label is built from pieces of text put together; the seat is a number and must become text first.", "JOIN puts two texts together. NUMBER AS TEXT turns the seat into text. The TEXT block offers the pieces this puzzle needs: \"-\" and \"0\".", "SET label TO row JOIN \"-\". IF seat is LESS THAN 10, SET label TO label JOIN \"0\". RETURN label JOIN (seat NUMBER AS TEXT)."],
  "validators": {"output": "equal"},
