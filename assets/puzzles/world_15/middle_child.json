  "concepts": ["sorting"],
  "prerequisites": [],
  "story": "For the class photo the children stand in one row, shortest first. The photographer focuses on the child in the middle of the row; when the number of children is even, on the left one of the two in the middle. Given the heights in the order the children arrived, return the height the photographer focuses on. There is always at least one child.",
  "io": {
    "inputs": [
      {"name": "heights", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 40},
    "notes": ["Heights are whole numbers from 90 to 160."]
  },
  "blocks": {
    "allow": ["arith.floor_div", "arith.sub", "arr.get", "arr.len", "arr.sort", "ctrl.return", "lit.num", "var.get"],
    "maxBlocks": 18
  },
  "limits": {"maxOps": 100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["In the order they arrived the middle child means nothing: put the row in order first.", "SORT puts the list itself in rising order. Then the answer is one GET ELEMENT away.", "After SORT heights, the position is (LENGTH of heights MINUS 1) FLOOR DIVIDE 2: for 4 children that is 1, the left of the two in the middle."],
  "validators": {"output": "equal"},
