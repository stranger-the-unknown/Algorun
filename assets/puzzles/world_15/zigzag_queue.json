{
  "id": "zigzag_queue",
  "version": 1,
  "title": "Zigzag Queue",
  "world": "world_15",
  "chapter": "alternate_ends_then_drain",
  "tier": 2,
  "mode": "build",
  "concepts": ["deque"],
  "prerequisites": [],
  "story": "At the fair, people join the line for the big wheel in a strange way. The first to arrive simply stands in line. The second squeezes in at the front, the third joins at the back, the fourth goes to the front again, and so on, turn by turn. Given the ticket numbers in the order people arrived, return the line from front to back.",
  "io": {
    "inputs": [
      {"name": "arrivals", "type": "array<num>"}
    ],
    "output": {"type": "array<num>"}
  },
  "constraints": {
    "n": {"min": 0, "max": 40},
    "notes": ["Ticket numbers are whole numbers from 1 to 999."]
  },
  "blocks": {
    "allow": ["arith.mod", "arr.append", "arr.get", "arr.len", "cmp.eq", "ctrl.else", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "deque.empty", "deque.pop_front", "deque.push_back", "deque.push_front", "lit.num", "logic.not", "new.array", "new.deque", "var.get", "var.set"],
    "maxBlocks": 56
  },
  "limits": {"maxOps": 450, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["People are added at both ends of the line. A deque is a line that is open at both ends.", "The person at position 0, 2, 4, … of arrivals goes to the back, the others to the front: i REMAINDER 2 tells them apart.", "PUSH BACK or PUSH FRONT each arrival into a NEW DEQUE. Then, WHILE the deque is NOT empty, APPEND its POP FRONT to a NEW LIST and RETURN that list."],
  "validators": {"output": "equal"},
