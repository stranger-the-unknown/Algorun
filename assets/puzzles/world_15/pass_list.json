        ]
      },
      {
        "id": "h07",
        "in": {"names": ["r", "s", "t", "u", "v"], "scores": [100, 0, 50, 49, 51], "mark": 50},
        "out": [
          {"type": "pair", "first": "r", "second": 100},
          {"type": "pair", "first": "t", "second": 50},
          {"type": "pair", "first": "v", "second": 51}
        ]
      }
    ]
  },
  "edgeCases": ["no candidates", "nobody passes", "everybody passes", "a score exactly on the mark", "a mark of 0"],
  "variables": {
    "pool": [
      {"name": "passed", "type": "array<pair<str,num>>"},
      {"name": "i", "type": "num"}
    ]
  },
  "reference": {"strategy": "zip_filter_into_pairs"}
}
