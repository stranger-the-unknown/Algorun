{
  "id": "top_scorer",
  "version": 1,
  "title": "Top Scorer",
  "world": "world_15",
  "chapter": "first_maximum_by_second",
  "tier": 1,
  "mode": "build",
  "concepts": ["pairs"],
  "prerequisites": [],
  "story": "After the quiz night every result is a pair: the player's name first, their points second. Return the name of the player with the most points. When several players share the top, the one who comes first in the list wins. There is always at least one result.",
  "io": {
    "inputs": [
      {"name": "results", "type": "array<pair<str,num>>"}
    ],
    "output": {"type": "str"}
  },
  "constraints": {
    "n": {"min": 1, "max": 30},
    "notes": ["Points are whole numbers and may be zero or negative."]
  },
  "blocks": {
    "allow": ["arr.get", "cmp.ge", "cmp.gt", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "pair.first", "pair.second", "var.get", "var.set"],
    "maxBlocks": 28
  },
  "limits": {"maxOps": 150, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Keep the best result seen so far, as a whole pair, and compare every result with it.", "SECOND reads the points of a pair, FIRST its name. Start with the result at position 0 as the best.", "FOR EACH r in results: IF (r SECOND) is GREATER THAN (best SECOND), SET best TO r. Strictly greater, so an equal score later in the list does not take over. RETURN (best FIRST)."],
  "validators": {"output": "equal"},
