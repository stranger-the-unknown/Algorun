{
  "id": "scout_reach",
  "version": 1,
  "title": "Scout Reach",
  "world": "world_10",
  "chapter": "iterative_dfs_reachable_count",
  "tier": 3,
  "mode": "build",
  "concepts": [
    "graph",
    "dfs"
  ],
  "prerequisites": [],
  "story": "A scout starts at one stop and may follow outgoing rides any number of times. Report how many different stops they can reach, including the start. Use a stack and MARK so a stop is entered once. Stops with no ride from the start stay uncounted.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      },
      {
        "name": "start",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a stop with no path from the start",
      "a loop",
      "counting every stop in the network"
    ]
  },
  "blocks": {
    "allow": [
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "graph.mark",
      "graph.neighbors",
      "graph.node_count",
      "graph.visited",
      "lit.num",
      "logic.not",
      "new.stack",
      "stack.empty",
      "stack.pop",
      "stack.push",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 51
  },
  "limits": {
    "maxOps": 266,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "MARK the start, push it, and while the stack IS NOT EMPTY pop a stop and count it.",
    "FOR EACH neighbour, if it is not VISITED, MARK it and push it.",
    "NODE COUNT counts stops the scout may never reach."
  ],
  "validators": {
    "output": "equal"
  },
