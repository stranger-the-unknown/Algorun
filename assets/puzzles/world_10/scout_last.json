  "story": "The same scout walks depth-first with a stack. Neighbours are pushed in the order NEIGHBORS lists them, so the last neighbour is popped first. Report the number of the last stop the scout pops. The start is always popped.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      },
      {
        "name": "start",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "breadth-first pops a different last stop",
      "a single stop",
      "neighbour order matters"
    ]
  },
  "blocks": {
    "allow": [
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "graph.mark",
      "graph.neighbors",
      "graph.visited",
      "lit.num",
      "logic.not",
      "new.queue",
      "new.stack",
      "queue.deq",
      "queue.empty",
      "queue.enq",
      "stack.empty",
      "stack.pop",
      "stack.push",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 51
  },
  "limits": {
    "maxOps": 266,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "This is the reach walk, but you remember the stop you just popped instead of only counting.",
    "Push neighbours in listed order and do not sort them.",
    "A queue would pop a different last stop. This scout uses a stack."
  ],
  "validators": {
    "output": "equal"
  },
