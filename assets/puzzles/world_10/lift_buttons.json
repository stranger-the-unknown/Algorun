{
  "id": "lift_buttons",
  "version": 1,
  "title": "Two Buttons",
  "world": "world_10",
  "chapter": "bfs_over_generated_states",
  "tier": 4,
  "mode": "build",
  "concepts": ["graph", "bfs", "queue"],
  "prerequisites": [],
  "story": "An old lift has two buttons. One moves it up by a fixed number of floors, the other moves it down by a fixed number of floors: the inputs up and down. The building's floors are numbered 1 to the input floors, and a press that would take the lift out of the building does nothing. What is the fewest presses that take the lift from the floor start to the floor goal? If no sequence of presses gets there, report -1; if the lift is already there, 0.",
  "io": {
    "inputs": [
      {"name": "floors", "type": "num"},
      {"name": "start", "type": "num"},
      {"name": "goal", "type": "num"},
      {"name": "up", "type": "num"},
      {"name": "down", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {"notes": ["1 to 500 floors; start and goal are floors of the building.", "up and down are at least 1."]},
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.mod", "arith.sub", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.eq", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "cmp.ne", "ctrl.break", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "logic.not", "logic.or", "new.array", "new.queue", "new.stack", "queue.deq", "queue.empty", "queue.enq", "stack.empty", "stack.pop", "stack.push", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 138
  },
  "limits": {"maxOps": 53450, "maxDepth": 32, "maxAlloc": 1050},
  "hints": ["Think of every floor as a stop with at most two rides out of it: one up, one down. The fewest presses is a shortest route, but nobody hands you the map: your program works out each floor's neighbours itself.", "Search in waves from the start with a queue. Keep a list with one entry per floor: the presses needed to reach it, or -1 while it has not been reached.", "DEQUEUE a floor. For the floor above (PLUS up) and the floor below (MINUS down): IF it is inside the building AND its entry is still -1, SET ELEMENT to this floor's count PLUS 1 and ENQUEUE it. RETURN the goal's entry when you DEQUEUE the goal, or -1 when the queue is empty."],
  "validators": {"output": "equal"},
