  "chapter": "count_sources_of_one_way_network",
  "tier": 4,
  "mode": "build",
  "concepts": ["graph"],
  "prerequisites": [],
  "story": "A news agency wants a story to reach every town. Roads between towns are one-way, and a town that hears the story sends it on along every road that leaves it. No route ever comes back to a town it has left. The agency phones as few towns as it can and lets the roads do the rest. How many towns must it phone? Towns are numbered from 0.",
  "io": {
    "inputs": [
      {"name": "roads", "type": "graph"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 80},
    "notes": ["1 to 80 towns.", "Following the roads never leads back to a town already left."]
  },
  "blocks": {
    "allow": ["arith.add", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.eq", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "cmp.ne", "ctrl.break", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "graph.mark", "graph.neighbors", "graph.node_count", "graph.visited", "lit.num", "logic.and", "logic.not", "logic.or", "new.array", "new.queue", "new.stack", "queue.deq", "queue.empty", "queue.enq", "stack.empty", "stack.pop", "stack.push", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 64
  },
  "limits": {"maxOps": 6150, "maxDepth": 32, "maxAlloc": 750},
  "hints": ["A town with a road leading into it will hear the story from the town at the other end, sooner or later. Which towns can never hear it from anyone?", "Only the towns with no incoming road need a phone call, and phoning all of them is enough: follow any town's incoming roads backwards and you must stop at such a town, because no route goes round in a circle.", "Make a list with a 0 for every town (NODE COUNT tells you how many). FOR every town, FOR EACH of its NEIGHBORS, add 1 to that neighbour's entry. Then count the entries that are still 0."],
  "validators": {"output": "equal"},
