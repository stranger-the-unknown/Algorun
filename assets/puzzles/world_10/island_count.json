    "inputs": [
      {"name": "islands", "type": "graph"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 800},
    "notes": ["Patches are numbered 0 to n-1.", "Every connection is listed in both directions."]
  },
