  "limits": {"maxOps": 40000, "maxDepth": 32, "maxAlloc": 5000},
  "hints": ["Starting from one patch and marking everything you can reach finds one whole island.", "Try every patch in turn; a patch that is not marked yet must belong to a new island.", "Each new island is one more search from its first patch, marking as you go, so no patch is searched twice."],
  "validators": {"output": "equal"},
