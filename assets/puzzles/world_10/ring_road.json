{
  "id": "ring_road",
  "version": 1,
  "title": "Ring Road",
  "world": "world_10",
  "chapter": "cycle_by_edge_count",
  "tier": 4,
  "mode": "build",
  "concepts": ["graph", "dfs"],
  "prerequisites": [],
  "story": "Roads join the villages of a county. Every road can be driven both ways and appears in the lists of both villages it joins; no road joins a village to itself, and no two roads join the same pair. Is there a ring road: a way to leave a village and come back to it without driving any road twice? Some villages may not be connected to the rest.",
  "io": {
    "inputs": [
      {"name": "roads", "type": "graph"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 1, "max": 500},
    "notes": ["Villages are numbered 0 to n-1.", "Every road is listed in both villages' lists."]
  },
  "blocks": {
    "allow": ["arith.mul", "cmp.ge", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "graph.mark", "graph.neighbors", "graph.node_count", "graph.visited", "lit.bool", "lit.num", "logic.not", "new.stack", "stack.empty", "stack.pop", "stack.push", "var.get", "var.inc", "var.set"],
    "maxBlocks": 88
  },
  "limits": {"maxOps": 15250, "maxDepth": 32, "maxAlloc": 1250},
  "hints": ["A connected part without a ring that has v villages has exactly v − 1 roads.", "Walk each part with a stack, counting its villages and the entries in their road lists (each road is listed twice).", "A part with at least as many roads as villages has a ring. Check every part, not only the first."],
  "validators": {"output": "equal"},
