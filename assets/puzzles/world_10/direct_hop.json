{
  "id": "direct_hop",
  "version": 1,
  "title": "Direct Hop",
  "world": "world_10",
  "chapter": "direct_edge_exists",
  "tier": 2,
  "mode": "build",
  "concepts": [
    "graph"
  ],
  "prerequisites": [],
  "story": "Report whether the goal is one direct ride from the start: the goal appears in the start's neighbour list. A ride the other way does not count. The answer is yes or no.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      },
      {
        "name": "start",
        "type": "num"
      },
      {
        "name": "goal",
        "type": "num"
      }
    ],
    "output": {
      "type": "bool"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "the ride exists only in the other direction",
      "the goal is not the first neighbour",
      "start and goal are the same stop with no loop"
    ]
  },
  "blocks": {
    "allow": [
      "arr.get",
      "arr.len",
      "cmp.eq",
      "ctrl.else",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "graph.neighbors",
      "lit.bool",
      "lit.num",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 30
  },
  "limits": {
    "maxOps": 40,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Read NEIGHBORS of the start only.",
    "FOR EACH neighbour, ask whether it equals the goal.",
    "The first neighbour is not the only door. If none match, the answer is no."
  ],
  "validators": {
    "output": "equal"
  },
