    "inputs": [
      {"name": "metro", "type": "graph"},
      {"name": "start", "type": "num"},
      {"name": "goal", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 500},
    "notes": ["Stations are numbered 0 to n-1.", "Start and goal are always real stations.", "Rides are one-way; a two-way line lists both directions."]
  },
  "blocks": {"allow": ["ctrl.for_range", "ctrl.foreach", "ctrl.while", "ctrl.if", "ctrl.return", "var.set", "var.get", "lit.num", "arr.get", "arr.set", "arr.append", "new.array", "new.queue", "queue.enq", "queue.deq", "queue.empty", "new.stack", "stack.push", "stack.pop", "stack.empty", "graph.neighbors", "graph.node_count", "graph.mark", "graph.visited", "cmp.eq", "logic.not", "arith.add"], "maxBlocks": 70},
  "limits": {"maxOps": 50000, "maxDepth": 32, "maxAlloc": 5000},
  "scoring": {"blockBudget": 70},
  "hints": ["Following rides from the start in any order will find a route, but not necessarily the shortest one.", "Explore in rounds: first every station one ride away, then every station two rides away, and so on. A queue keeps the stations in the order you discovered them.", "Record each station's ride count the first time you discover it, as one more than the station you reached it from, and never change it afterwards. Decide what a station that is never discovered should report."],
