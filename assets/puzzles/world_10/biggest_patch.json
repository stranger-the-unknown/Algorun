{
  "id": "biggest_patch",
  "version": 1,
  "title": "Biggest Patch",
  "world": "world_10",
  "chapter": "largest_weak_component",
  "tier": 3,
  "mode": "build",
  "concepts": [
    "graph",
    "dfs"
  ],
  "prerequisites": [],
  "story": "Rides go both ways: if one stop lists another, the other lists it back. A patch is a group you can travel inside. Report how many stops are in the largest patch. A stop with no rides is a patch of one.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "two separate patches",
      "an isolated stop",
      "assuming the network is one patch"
    ]
  },
  "blocks": {
    "allow": [
      "cmp.gt",
      "ctrl.for_range",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "graph.mark",
      "graph.neighbors",
      "graph.node_count",
      "graph.visited",
      "lit.num",
      "logic.not",
      "new.stack",
      "stack.empty",
      "stack.pop",
      "stack.push",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 64
  },
  "limits": {
    "maxOps": 355,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Try every stop that is not yet VISITED as the start of a new patch.",
    "Count the patch with the same stack walk as Scout Reach.",
    "Keep the largest count. The whole network is one patch only when every stop is reachable from every other."
  ],
  "validators": {
    "output": "equal"
  },
