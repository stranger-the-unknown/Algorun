  "world": "world_10",
  "chapter": "bfs_eccentricity",
  "tier": 4,
  "mode": "optimize",
  "concepts": [
    "graph",
    "bfs"
  ],
  "prerequisites": [],
  "story": "From the start, each ride costs one hop. Report the largest number of hops needed to reach any stop that can be reached. Unreachable stops do not count. The start itself is distance 0, so a lone start is 0.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      },
      {
        "name": "start",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "unreachable stops",
      "repeating the search once per stop is over budget",
      "a start with no rides"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arr.append",
      "arr.get",
      "arr.set",
      "cmp.eq",
      "cmp.gt",
      "ctrl.for_range",
      "ctrl.foreach",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "graph.neighbors",
      "graph.node_count",
      "lit.num",
      "logic.not",
      "new.array",
      "new.queue",
      "queue.deq",
      "queue.empty",
      "queue.enq",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 89
  },
  "limits": {
    "maxOps": 906,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true,
    "baselineFactor": 5
  },
  "hints": [
    "A queue walks stops in order of distance. A list can store the distance of each stop, -1 meaning unseen.",
    "When you first reach a neighbour, its distance is one more than the stop you came from.",
    "The answer is the largest distance you write. Searching the whole network again for every stop is too slow."
  ],
  "validators": {
    "output": "equal"
  },
