  "concepts": ["graph", "bfs", "queue"],
  "prerequisites": [],
  "story": "Villages are joined by roads that can be driven both ways; each road appears in the lists of both villages it joins, no road joins a village to itself, and no two roads join the same pair. A ring is a round trip that starts and ends in the same village and uses no road and no other village twice. How many roads does the shortest ring have? If there is no ring at all, report -1.",
  "io": {
    "inputs": [
      {"name": "roads", "type": "graph"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 40},
    "notes": ["1 to 40 villages, numbered from 0.", "Every road is listed by both villages it joins."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.sub", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.eq", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "cmp.ne", "ctrl.break", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "graph.mark", "graph.neighbors", "graph.node_count", "graph.visited", "lit.num", "logic.and", "logic.not", "logic.or", "new.array", "new.queue", "new.stack", "queue.deq", "queue.empty", "queue.enq", "stack.empty", "stack.pop", "stack.push", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 164
  },
  "limits": {"maxOps": 300000, "maxDepth": 32, "maxAlloc": 20000},
  "hints": ["Search in waves from one village, remembering for every village its distance and the village it was reached from. When you look along a road and find a village that already has a distance, and it is not the one you came from, two ways out of the start have met: a ring is closed.", "That ring has at most the two distances PLUS 1 roads, and when the start lies on the shortest ring this is exactly its length. So repeat the search from every village and keep the smallest.", "MARK cannot be taken back, so keep your own lists: before each search SET ELEMENT every distance to -1. In the search: IF the neighbour's distance is -1, give it a distance, write down where it came from and ENQUEUE it; ELSE IF it is NOT EQUAL to where you came from, the ring has your distance PLUS its distance PLUS 1 roads."],
  "validators": {"output": "equal"},
