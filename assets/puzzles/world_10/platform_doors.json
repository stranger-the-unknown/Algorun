{
  "id": "platform_doors",
  "version": 1,
  "title": "Platform Doors",
  "world": "world_10",
  "chapter": "out_degree",
  "tier": 2,
  "mode": "build",
  "concepts": [
    "graph"
  ],
  "prerequisites": [],
  "story": "A station network lists, for each stop, the stops you can ride to directly. Report how many doors the given station has — how many neighbours it lists. Stops are numbered from 0.",
  "io": {
    "inputs": [
      {
        "name": "roads",
        "type": "graph"
      },
      {
        "name": "station",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a stop with no doors",
      "treating only stop zero as real"
    ]
  },
  "blocks": {
    "allow": [
      "arr.len",
      "cmp.eq",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "graph.neighbors",
      "lit.num",
      "var.get"
    ],
    "maxBlocks": 24
  },
  "limits": {
    "maxOps": 25,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "NEIGHBORS gives the list of doors from a stop.",
    "LENGTH of that list is the answer.",
    "Do not answer 0 for every station except stop zero."
  ],
  "validators": {
    "output": "equal"
  },
