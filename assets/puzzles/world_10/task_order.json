{
  "id": "task_order",
  "version": 1,
  "title": "Task Order",
  "world": "world_10",
  "chapter": "kahn_cycle_check",
  "tier": 4,
  "mode": "build",
  "concepts": ["graph", "topological_order"],
  "prerequisites": ["tree", "queue"],
  "story": "A project plan lists numbered tasks, and for each task the tasks that may only start after it is finished. Can every task be done in some order that respects all the rules? A plan where tasks end up waiting for each other in a circle can never be finished.",
  "io": {
    "inputs": [
      {"name": "tasks", "type": "graph"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 1, "max": 500},
    "notes": ["Tasks are numbered 0 to n-1.", "A rule u -> v means u before v."]
  },
  "blocks": {"allow": ["arith.add", "arith.sub", "arr.append", "arr.get", "arr.set", "cmp.eq", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "graph.neighbors", "graph.node_count", "lit.bool", "lit.num", "logic.not", "new.array", "new.queue", "queue.deq", "queue.empty", "queue.enq", "var.get", "var.inc", "var.set"], "maxBlocks": 97},
  "limits": {"maxOps": 60000, "maxDepth": 32, "maxAlloc": 6000},
  "hints": ["Count, for every task, how many tasks must come before it.", "Tasks with nothing before them can start now. Doing one lowers the count of every task after it; a count reaching 0 means that task can start too.", "If you manage to do every task this way, the plan works. Tasks caught in a circle never reach 0 — even when other tasks can start."],
  "validators": {"output": "equal"},
