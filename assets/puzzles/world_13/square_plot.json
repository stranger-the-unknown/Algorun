  "tier": 4,
  "mode": "optimize",
  "concepts": ["dp"],
  "prerequisites": [],
  "story": "A field map is a grid: 1 marks fertile ground and 0 marks rock. A farmer wants the largest square plot made only of fertile ground. Report its area: a square with 3 cells on each side has area 9, and a map with no fertile cell gives 0. Trying every possible square cell by cell is far too slow for a big map.",
  "io": {
    "inputs": [
      {"name": "field", "type": "array<array<num>>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 40},
    "notes": ["1 to 40 rows and 1 to 40 columns; every row has the same length.", "Every cell is 0 or 1."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.mul", "arith.sub", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.eq", "cmp.le", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "new.array", "var.get", "var.set"],
    "maxBlocks": 106
  },
  "limits": {"maxOps": 150000, "maxDepth": 32, "maxAlloc": 10000},
  "performance": {"required": true, "baselineFactor": 5},
  "hints": ["For every cell, ask: how long is the side of the largest fertile square whose bottom-right corner is this cell? A rock cell gives 0.", "A fertile cell grows three squares at once: the ones that end just above it, just to its left, and diagonally up and to the left. Its own side is 1 PLUS the MIN of those three.", "Keep the answers of the row above in one list and build the current row in a NEW LIST; start each row with an extra 0 so the first column has a left neighbour too. Remember the longest side and RETURN side TIMES side."],
