{
  "id": "aisle_cost",
  "version": 1,
  "title": "Aisle Cost",
  "world": "world_13",
  "chapter": "min_path_right_down",
  "tier": 3,
  "mode": "build",
  "concepts": [
    "dp"
  ],
  "prerequisites": [],
  "story": "A warehouse is a grid of aisle costs. You start at the top-left square and may step only right or down, and you must finish at the bottom-right. Report the cheapest sum of squares you step on, including both corners. Costs are never negative.",
  "io": {
    "inputs": [
      {
        "name": "grid",
        "type": "array<array<num>>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a single square",
      "a single row",
      "paying for every square"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.min",
      "arith.sub",
      "arr.get",
      "arr.len",
      "arr.set",
      "ctrl.for_range",
      "ctrl.return",
      "lit.num",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 106
  },
  "limits": {
    "maxOps": 319,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "The cheapest way into a square is its own cost plus the cheaper of the square above and the square to the left.",
    "The first row can only be reached from the left, and the first column only from above.",
    "Adding every square in the warehouse pays for aisles you never walk."
  ],
  "validators": {
    "output": "equal"
  },
