    ],
    "maxBlocks": 56
  },
  "limits": {
    "maxOps": 130,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "The cheapest way to land on a stone is its toll plus the cheaper of the two stones you could have come from.",
    "You always pay the first stone. The second stone can only be reached from the first, so it costs both tolls.",
    "Paying every stone is not required: a jump skips one."
  ],
  "validators": {
    "output": "equal"
  },
