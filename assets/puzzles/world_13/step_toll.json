  "limits": {
    "maxOps": 130,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "The cheapest way to land on a stone is its toll plus the cheaper of the two stones you could have come from.",
    "The first stone can only be reached in one way. The second can come from the start or from the first.",
    "Paying every stone is not required: a jump skips one."
  ],
  "validators": {
    "output": "equal"
  },
