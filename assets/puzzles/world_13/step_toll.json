  "story": "Each stone charges a toll when you land on it. You start on the first stone and pay its toll. From a stone you may jump one or two stones ahead, and you must finish on the last stone. Report the cheapest total toll. No stones costs 0. One stone costs that stone.",
  "io": {
    "inputs": [
      {
        "name": "costs",
        "type": "array<num>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "no stones",
      "one stone",
      "paying every stone"
    ]
  },
