  "concepts": ["dp"],
  "prerequisites": [],
  "story": "A canteen cooks one dish a day: soup, pasta or rice. costs lists, for every day, what each of the three dishes would cost that day, in that order (ingredient prices change). The same dish is never cooked two days in a row. What is the cheapest total for all the days? The cheapest dish of the day is not always the right choice: it may block a much cheaper one tomorrow. With no days at all, the answer is 0.",
  "io": {
    "inputs": [
      {"name": "costs", "type": "array<array<num>>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 60},
    "notes": ["0 to 60 days, each with exactly three costs.", "Costs are whole numbers from 1 to 50."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.min", "arr.get", "arr.len", "cmp.eq", "cmp.lt", "cmp.ne", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "logic.and", "logic.or", "var.get", "var.set"],
    "maxBlocks": 68
  },
  "limits": {"maxOps": 20000, "maxDepth": 32, "maxAlloc": 2000},
  "hints": ["For each of the three dishes, keep the cheapest total so far of a menu that ends with that dish.", "A menu that ends with soup today costs today's soup PLUS the cheaper of the two totals that ended with pasta or rice yesterday: the MIN of those two.", "Work out the new totals from the old ones before you overwrite an old one that is still needed (use spare variables). At the end RETURN the MIN of the three."],
  "validators": {"output": "equal"},
