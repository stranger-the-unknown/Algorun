{
  "id": "pack_bins",
  "version": 1,
  "title": "Pack Bins",
  "world": "world_13",
  "chapter": "zero_one_knapsack",
  "tier": 4,
  "mode": "optimize",
  "concepts": [
    "dp"
  ],
  "prerequisites": [],
  "story": "Each crate has a weight and a value, and it may be packed at most once. The bin holds at most the given capacity. Report the largest total value you can pack. No crates, or no capacity, is 0. Weights are at least 1.",
  "io": {
    "inputs": [
      {
        "name": "weights",
        "type": "array<num>"
      },
      {
        "name": "values",
        "type": "array<num>"
      },
      {
        "name": "cap",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "a crate heavier than the bin",
      "using a crate twice",
      "trying every subset is over budget"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.floor_div",
      "arith.mod",
      "arith.mul",
      "arith.sub",
      "arr.append",
      "arr.get",
      "arr.len",
      "arr.set",
      "cmp.eq",
      "cmp.gt",
      "cmp.le",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "logic.and",
      "new.array",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 71
  },
  "limits": {
    "maxOps": 3802,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true,
    "baselineFactor": 8
  },
  "hints": [
    "Keep a list of the best value for every capacity from 0 up to the limit.",
    "For each crate, walk the capacities downward so the crate is not used twice.",
    "Trying every subset is correct and far too slow once there are many crates."
  ],
  "validators": {
    "output": "equal"
  },
