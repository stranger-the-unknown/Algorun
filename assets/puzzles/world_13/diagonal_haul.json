      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "lit.num",
      "logic.and",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 149
  },
  "limits": {
    "maxOps": 830,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "The best total at a square is its cargo plus the best of the three squares you could have come from: left, above, and above-left.",
    "The first square has no previous square; its total is just its cargo.",
    "Staying on the first row misses cargo that a downward step would collect."
  ],
  "validators": {
    "output": "equal"
  },
