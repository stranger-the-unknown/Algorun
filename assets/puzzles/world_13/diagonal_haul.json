  "story": "A haul may step right, down, or diagonally down-right. Each square adds its cargo, which may be negative. Start at the top-left and finish at the bottom-right. Report the largest total you can collect.",
  "io": {
    "inputs": [
      {
        "name": "grid",
        "type": "array<array<num>>"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "negative cargo",
      "a downward step beats the first row",
      "a single square"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.max",
      "arith.sub",
      "arr.get",
      "arr.len",
      "arr.set",
      "cmp.eq",
      "cmp.gt",
