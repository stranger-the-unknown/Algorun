  "concepts": ["variables", "control"],
  "prerequisites": [],
  "story": "A savings jar holds some coins. At the end of every week the number of coins in the jar doubles. After how many weeks does the jar hold at least the goal? If it already holds enough, the answer is 0 weeks.",
  "io": {
    "inputs": [
      {"name": "coins", "type": "num"},
      {"name": "goal", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {"notes": ["The jar starts with 1 to 1000 coins.", "The goal is 1 to 1000000 coins."]},
  "blocks": {
    "allow": ["arith.add", "arith.mul", "cmp.ge", "cmp.le", "cmp.lt", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "var.get", "var.inc", "var.set"],
    "maxBlocks": 24
  },
  "limits": {"maxOps": 400, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Keep the coins in the jar and a week counter, and repeat the doubling while there are still too few coins.", "WHILE repeats as long as its condition holds: here, while the jar holds LESS THAN the goal.", "If the jar starts at or above the goal the loop must not run at all, so the answer is 0."],
  "validators": {"output": "equal"},
