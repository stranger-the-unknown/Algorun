  "story": "Round tables at a party each seat the same number of guests. How many tables must be set out so that every guest has a seat? A table may be left partly empty, and with no guests no table is needed.",
  "io": {
    "inputs": [
      {"name": "guests", "type": "num"},
      {"name": "seats", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {"notes": ["There are 0 to 1000 guests.", "A table seats 1 to 20 guests."]},
  "blocks": {
    "allow": ["arith.add", "arith.floor_div", "arith.mod", "cmp.eq", "cmp.gt", "cmp.ne", "ctrl.if", "ctrl.return", "lit.num", "var.get", "var.inc", "var.set"],
    "maxBlocks": 21
  },
  "limits": {"maxOps": 100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["FLOOR DIVIDE tells how many tables are filled completely.", "If the REMAINDER is not 0, some guests are left over and need one more table.", "When the guests fill the tables exactly, no extra table is needed, and 0 guests need 0 tables."],
