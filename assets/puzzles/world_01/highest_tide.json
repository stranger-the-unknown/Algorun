    "n": {"min": 0, "max": 300},
    "notes": ["Levels are whole numbers from -300 to 300."]
  },
  "blocks": {"allow": ["arr.get", "arr.len", "cmp.eq", "cmp.ge", "cmp.gt", "ctrl.for_range", "ctrl.if", "ctrl.return", "lit.num", "logic.and", "logic.or", "var.get", "var.set"], "maxBlocks": 30},
  "limits": {"maxOps": 5000, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Keep the position of the best measurement seen so far, and compare each new one with it.", "Before anything has been seen there is no best yet; -1 can stand for that, and it is also the answer for an empty day.", "Only replace the best when a measurement is strictly higher, so the earliest of equal highs stays."],
