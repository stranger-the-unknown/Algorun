  "title": "Digit Wheels",
  "world": "world_01",
  "chapter": "count_decimal_digits",
  "tier": 1,
  "mode": "edge",
  "concepts": ["variables", "control"],
  "prerequisites": [],
  "story": "A mechanical counter prints a number with one wheel for each digit. How many wheels does it need to print the given number? The number has no leading zeros, and printing 0 still needs one wheel.",
  "io": {
    "inputs": [
      {"name": "number", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {"notes": ["The number is a whole number from 0 to 999999999."]},
  "blocks": {
    "allow": ["arith.floor_div", "cmp.eq", "cmp.ge", "cmp.gt", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "var.get", "var.inc", "var.set"],
    "maxBlocks": 24
  },
  "limits": {"maxOps": 200, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Count how many times you can chop the last digit off the number.", "FLOOR DIVIDE by 10 drops the last digit; repeat WHILE the number is still 10 or more.", "Remember 0: it is printed as a single digit, so the answer is never 0."],
  "validators": {"output": "equal"},
