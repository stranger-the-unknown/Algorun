  "concepts": ["variables", "control"],
  "prerequisites": [],
  "story": "A staircase has steps numbered 1, 2, 3 and so on up to the top step. An electrician fits a light on every step whose number is a multiple of the gap: with a gap of 3, steps 3, 6, 9 and so on. How many lights are fitted? The top step counts too.",
  "io": {
    "inputs": [
      {"name": "steps", "type": "num"},
      {"name": "gap", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {"notes": ["The staircase has 0 to 500 steps.", "The gap is a whole number from 1 to 50."]},
  "blocks": {
    "allow": ["arith.add", "arith.mod", "cmp.eq", "ctrl.for_range", "ctrl.if", "ctrl.return", "lit.num", "var.get", "var.inc", "var.set"],
    "maxBlocks": 26
  },
  "limits": {"maxOps": 7100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Visit every step number from 1 up to the top one and count the steps that get a light.", "A step gets a light when the REMAINDER of its number divided by the gap is 0.", "FOR stops just before its TO value, so to include the top step the loop must run up to one past it."],
