  "story": "A carpenter wants to nail three planks into a triangular frame. It works only if every plank is shorter than the other two put together; if one plank is exactly as long as the other two together, the frame collapses flat. Can the three planks make a frame?",
  "io": {
    "inputs": [
      {"name": "a", "type": "num"},
      {"name": "b", "type": "num"},
      {"name": "c", "type": "num"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {"notes": ["Each plank is 1 to 1000 long."]},
  "blocks": {
    "allow": ["arith.add", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.if", "ctrl.return", "lit.bool", "logic.and", "logic.or", "var.get"],
    "maxBlocks": 29
  },
  "limits": {"maxOps": 100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["There are three checks, one for each plank against the sum of the other two.", "Combine the checks with AND: the frame works only if all three hold.", "Use GREATER THAN, not GREATER OR EQUAL: equal lengths make a flat frame, which does not count."],
