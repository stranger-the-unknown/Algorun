    "allow": ["cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.if", "ctrl.return", "lit.num", "var.get"],
    "maxBlocks": 23
  },
  "limits": {"maxOps": 100, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["There are three prices. Use IF to check one age group at a time and RETURN its price.", "Check the free group first with LESS THAN, then the older visitors with GREATER OR EQUAL; whoever is left pays 10.", "Mind the edges: a 6-year-old already pays 10, and a 65-year-old already pays 4."],
