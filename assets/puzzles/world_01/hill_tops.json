{
  "id": "hill_tops",
  "version": 1,
  "title": "Hill Tops",
  "world": "world_01",
  "chapter": "count_strict_local_peaks",
  "tier": 2,
  "mode": "build",
  "concepts": ["variables", "control"],
  "prerequisites": [],
  "story": "A hiking app stores a trail as the heights of evenly spaced points, from start to finish. A hilltop is a point strictly higher than both the point just before it and the point just after it. The first and last points have only one neighbour, so they are never hilltops, and a flat top where two neighbouring points share the same height is not a hilltop either. How many hilltops does the trail have?",
  "io": {
    "inputs": [
      {"name": "heights", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 300},
    "notes": ["Heights are whole numbers from -500 to 500."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.sub", "arr.get", "arr.len", "cmp.ge", "cmp.gt", "ctrl.for_range", "ctrl.if", "ctrl.return", "lit.num", "logic.and", "var.get", "var.inc", "var.set"],
    "maxBlocks": 50
  },
  "limits": {"maxOps": 9400, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Only points with a neighbour on both sides can be hilltops: from position 1 up to the one before the last.", "Use GET ELEMENT with the position MINUS 1 and PLUS 1 to reach the two neighbours.", "Both neighbours must be strictly lower: GREATER THAN on both sides, joined with AND."],
  "validators": {"output": "equal"},
