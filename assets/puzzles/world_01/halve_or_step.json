  ],
  "prerequisites": [],
  "story": "A counting machine is given a starting number and plays with it until nothing is left. The program is the machine's rule book, and what it returns is how long the game lasted. Read the program and say what it returns for each starting number.",
  "io": {
    "inputs": [
      {
        "name": "start",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "notes": [
      "The starting number is a whole number from 0 to 1000."
    ]
  },
  "blocks": {
    "allow": [
      "arith.floor_div",
      "arith.mod",
      "cmp.eq",
      "cmp.gt",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 33
  },
  "limits": {
    "maxOps": 700,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "Keep a small table on paper: one row per trip through WHILE, with x and moves in it.",
    "REMAINDER 2 is 0 for an even number. Even numbers take the first branch, odd numbers the ELSE branch.",
    "For 5 the number goes 5, 4, 2, 1, 0: four moves. Count the steps between the numbers, not the numbers."
  ],
  "validators": {
    "output": "equal"
  },
