{
  "id": "flag_lines",
  "version": 1,
  "title": "Flag Lines",
  "world": "world_01",
  "chapter": "sum_of_growing_terms",
  "tier": 1,
  "mode": "complete",
  "concepts": [
    "variables",
    "control"
  ],
  "prerequisites": [],
  "story": "For a street party, flags hang in lines across the road. The first line holds 1 flag, and every line holds 2 more flags than the line before it: 1, 3, 5, 7 and so on. How many flags hang in all the lines together? The program already walks through the lines; what happens at each line is missing.",
  "io": {
    "inputs": [
      {
        "name": "lines",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "notes": [
      "There are 0 to 40 lines."
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "ctrl.for_range",
      "ctrl.return",
      "lit.num",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 26
  },
  "limits": {
    "maxOps": 1150,
    "maxDepth": 32,
    "maxAlloc": 50
  },
  "hints": [
    "Each trip through the loop is one line of flags: that line has to be added to the total.",
    "After a line is added, flags must be made ready for the next line, which holds 2 more.",
    "Inside FOR: SET total to total PLUS flags, then SET flags to flags PLUS 2."
  ],
  "validators": {
    "output": "equal"
  },
  "fixtures": {
    "visible": [
      {
        "id": "v1",
        "in": {
          "lines": 3
        },
        "out": 9
      },
