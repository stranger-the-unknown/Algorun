  "title": "Warm Readings",
  "world": "world_01",
  "chapter": "count_above_threshold",
  "tier": 1,
  "mode": "build",
  "concepts": ["variables", "control"],
  "prerequisites": [],
  "story": "A greenhouse sensor logs one temperature reading after another. The gardener wants to know how many readings were strictly warmer than the comfort limit. A reading exactly at the limit is still comfortable.",
  "io": {
    "inputs": [
      {"name": "readings", "type": "array<num>"},
      {"name": "limit", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 200},
    "notes": ["Readings are whole numbers from -50 to 50."]
  },
  "blocks": {"allow": ["arith.add", "arr.get", "arr.len", "cmp.ge", "cmp.gt", "cmp.lt", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "lit.num", "var.get", "var.inc", "var.set"], "maxBlocks": 20},
  "limits": {"maxOps": 3000, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Walk the readings one at a time and keep a count that starts at 0.", "Only a reading strictly above the limit adds to the count; decide which comparison says that.", "A reading equal to the limit must not count, and an empty log reports 0."],
  "validators": {"output": "equal"},
