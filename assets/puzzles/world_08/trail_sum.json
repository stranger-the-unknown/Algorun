{
  "id": "trail_sum",
  "version": 1,
  "title": "Trail Sum",
  "world": "world_08",
  "chapter": "root_to_leaf_state",
  "tier": 4,
  "mode": "build",
  "concepts": ["tree", "dfs"],
  "prerequisites": ["linked_list", "stack"],
  "story": "Hiking trails branch like a tree from the trailhead. Every junction and every trail's end is marked with a number of points, and some marks are negative. A full trail runs from the trailhead to a dead end, where nothing branches on. Is there a full trail whose marks add up to exactly the target? Stopping halfway does not count.",
  "io": {
    "inputs": [
      {"name": "root", "type": "treeNode?"},
      {"name": "target", "type": "num"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 200},
    "notes": ["Marks are whole numbers from -9 to 9."]
  },
  "blocks": {"allow": ["arith.add", "cmp.eq", "ctrl.else", "ctrl.if", "ctrl.return", "ctrl.while", "lit.bool", "lit.num", "logic.and", "logic.is_not_nothing", "logic.is_nothing", "logic.not", "logic.or", "new.stack", "stack.empty", "stack.pop", "stack.push", "tree.left", "tree.right", "tree.value", "var.get", "var.set"], "maxBlocks": 87},
  "limits": {"maxOps": 20000, "maxDepth": 32, "maxAlloc": 1000},
  "hints": ["Walk the tree with a stack, and carry the running total of the trail so far next to each junction, in a second stack.", "Negative marks mean you cannot stop early just because a total got too big.", "Only a dead end — no LEFT and no RIGHT — may end a trail. A junction whose running total hits the target is not an answer by itself."],
  "validators": {"output": "equal"},
