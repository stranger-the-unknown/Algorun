{
  "id": "node_census",
  "version": 1,
  "title": "Node Census",
  "world": "world_08",
  "chapter": "iterative_tree_size",
  "tier": 2,
  "mode": "build",
  "concepts": [
    "tree"
  ],
  "prerequisites": [],
  "story": "Count every node in the tree. There is no recursion: keep a stack of nodes still to visit, and only push a child after you have checked it is not empty. An empty tree is 0.",
  "io": {
    "inputs": [
      {
        "name": "root",
        "type": "treeNode?"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "an empty tree",
      "a skewed tree",
      "counting only one spine"
    ]
  },
  "blocks": {
    "allow": [
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.is_not_nothing",
      "logic.not",
      "new.stack",
      "stack.empty",
      "stack.pop",
      "stack.push",
      "tree.left",
      "tree.right",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 50
  },
  "limits": {
    "maxOps": 249,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "If the root IS NOT NOTHING, push it.",
    "Pop a node, count it, then push LEFT and RIGHT only when each IS NOT NOTHING.",
    "Counting only the left vine misses the rest of the tree."
  ],
  "validators": {
    "output": "equal"
  },
