{
  "id": "sorted_grove",
  "version": 1,
  "title": "Sorted Grove",
  "world": "world_08",
  "chapter": "inorder_stack_check",
  "tier": 4,
  "mode": "build",
  "concepts": ["tree", "bst"],
  "prerequisites": ["linked_list", "stack"],
  "story": "In a well-kept grove, every tree label follows one rule: everything on a tree's left side is labelled strictly smaller than it, and everything on its right side strictly larger — not just its own two branches, but every label below them. Is this grove well kept?",
  "io": {
    "inputs": [
      {"name": "root", "type": "treeNode?"}
    ],
    "output": {"type": "bool"}
  },
  "constraints": {
    "n": {"min": 0, "max": 250},
    "notes": ["Labels are whole numbers from -15,000 to 15,000."]
  },
  "blocks": {"allow": ["cmp.ge", "cmp.le", "cmp.lt", "ctrl.else", "ctrl.if", "ctrl.return", "ctrl.while", "lit.bool", "lit.num", "logic.and", "logic.is_not_nothing", "logic.is_nothing", "logic.not", "logic.or", "new.stack", "stack.empty", "stack.pop", "stack.push", "tree.left", "tree.right", "tree.value", "var.get", "var.set"], "maxBlocks": 66},
  "limits": {"maxOps": 20000, "maxDepth": 32, "maxAlloc": 1000},
  "hints": ["Checking each tree against its own two branches is not enough: a label deep on the left can still be larger than a tree higher up.", "Reading a well-kept grove left side first, then the tree, then its right side, gives the labels in strictly increasing order.", "Do that reading with a stack: go left as far as possible pushing trees, pop one, compare it with the previous label, then continue from its right branch."],
  "validators": {"output": "equal"},
