{
  "id": "lowest_leaf",
  "version": 1,
  "title": "Lowest Leaf",
  "world": "world_08",
  "chapter": "minimum_leaf_value",
  "tier": 3,
  "mode": "build",
  "concepts": [
    "tree"
  ],
  "prerequisites": [],
  "story": "Among the leaves only, report the smallest mark. Marks inside the tree that still have a child do not count, even when they are smaller. If there is no leaf, report -1.",
  "io": {
    "inputs": [
      {
        "name": "root",
        "type": "treeNode?"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "the smallest mark is not a leaf",
      "a single node",
      "an empty tree"
    ]
  },
  "blocks": {
    "allow": [
      "arith.min",
      "cmp.eq",
      "ctrl.else",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.and",
      "logic.is_not_nothing",
      "logic.is_nothing",
      "logic.not",
      "new.stack",
      "stack.empty",
      "stack.pop",
      "stack.push",
      "tree.left",
      "tree.right",
      "tree.value",
      "var.get",
      "var.set"
    ],
    "maxBlocks": 80
  },
  "limits": {
    "maxOps": 315,
    "maxDepth": 64,
    "maxAlloc": 100000
  },
  "hints": [
    "Walk every node with a stack.",
    "Update the best mark only when both children are empty.",
    "Start the best at nothing-yet, and if you never see a leaf the answer is -1."
  ],
  "validators": {
    "output": "equal"
  },
  "fixtures": {
