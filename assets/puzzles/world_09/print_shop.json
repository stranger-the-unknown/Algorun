    "inputs": [
      {"name": "arrive", "type": "array<num>"},
      {"name": "pages", "type": "array<num>"}
    ],
    "output": {"type": "array<num>"}
  },
  "constraints": {
    "n": {"min": 0, "max": 200},
    "notes": ["Up to 200 jobs, listed by arrival minute (0 to 5000); each has 1 to 30 pages.", "arrive and pages have the same length."]
