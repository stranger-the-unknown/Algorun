  "story": "Meetings are listed by start time: meeting i runs from starts[i] to ends[i]. A room is free again the moment its meeting ends, so a meeting may start in a room at the very minute another one ends there. How many rooms are needed for all the meetings?",
  "io": {
    "inputs": [
      {"name": "starts", "type": "array<num>"},
      {"name": "ends", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 200},
    "notes": ["Up to 200 meetings, listed by start time; starts and ends have the same length.", "Every meeting ends after it starts."]
  },
  "blocks": {
    "allow": ["arith.max", "arr.get", "arr.len", "cmp.le", "cmp.lt", "ctrl.for_range", "ctrl.if", "ctrl.return", "heap.empty", "heap.insert", "heap.size", "heap.take", "heap.top", "lit.num", "logic.and", "logic.not", "new.max_heap", "new.min_heap", "var.get", "var.set"],
    "maxBlocks": 45
  },
  "limits": {"maxOps": 7950, "maxDepth": 32, "maxAlloc": 100},
  "hints": ["Keep the end times of the meetings in rooms in a NEW MIN HEAP: TOP is the room that frees up first.", "For each meeting, IF NOT (ending IS EMPTY) AND TOP ending is LESS OR EQUAL to its start, that room is free: TAKE TOP it. Then INSERT the meeting's end.", "The rooms in use at the end are all the rooms ever needed: RETURN the heap's SIZE. A meeting that starts as another ends does not need a new room."],
  "validators": {"output": "equal"},
