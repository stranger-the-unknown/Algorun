  "concepts": ["heap", "graph"],
  "prerequisites": [],
  "story": "A field is a grid of squares, each with a toll from 1 to 9. Walk from the top-left square to the bottom-right one, a step at a time up, down, left or right; every square you stand on, the first and last too, costs its toll. What is the cheapest walk? It may go up or left to get round expensive squares. Square r, c is number r × cols + c, and a heap holds one number, so put in cost × 1000 + square.",
  "io": {
    "inputs": [
      {"name": "grid", "type": "array<array<num>>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 20},
    "notes": ["1 to 20 rows and 1 to 20 columns; every row is the same length.", "Tolls are 1 to 9."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.floor_div", "arith.min", "arith.mod", "arith.mul", "arith.sub", "arr.append", "arr.get", "arr.len", "arr.set", "cmp.eq", "cmp.ge", "cmp.lt", "ctrl.else", "ctrl.for_range", "ctrl.if", "ctrl.return", "ctrl.while", "heap.empty", "heap.insert", "heap.size", "heap.take", "heap.top", "lit.num", "logic.and", "logic.not", "new.array", "new.max_heap", "new.min_heap", "var.get", "var.set"],
    "maxBlocks": 256
  },
  "limits": {"maxOps": 200800, "maxDepth": 32, "maxAlloc": 1000},
  "hints": ["Start a NEW MIN HEAP with the first square: its toll × 1000 + 0. TAKE TOP always gives the cheapest walk found so far: its cost is the number FLOOR DIVIDE 1000, its square the REMAINDER.", "Keep a list done of 0s, one per square. The first time a square comes out of the heap, its cost is the cheapest: SET ELEMENT done to 1. IF it is the last square, RETURN the cost.", "From a square, try the four steps (two lists dr and dc of 1, -1, 0, 0 help): for each neighbour inside the field that is not done, INSERT (cost PLUS its toll) × 1000 PLUS its number. A square may go in several times; only the first one out counts."],
  "validators": {"output": "equal"},
