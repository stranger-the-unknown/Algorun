    "maxBlocks": 53
  },
  "limits": {"maxOps": 16250, "maxDepth": 32, "maxAlloc": 450},
  "hints": ["Keep the piles in a NEW MAX HEAP: TOP is always the biggest pile.", "Each turn: TAKE TOP the biggest, then INSERT what is left of it: the pile MINUS (the pile FLOOR DIVIDE 2).", "At the end, TAKE TOP every pile WHILE the heap is NOT EMPTY and add them up."],
