  "chapter": "take_k_from_max_heap",
  "tier": 2,
  "mode": "build",
  "concepts": ["heap"],
  "prerequisites": [],
  "story": "The scoreboard adds up the k best scores of the night. If fewer than k scores came in, it adds up all of them. A MAX heap always has its largest number on top: put every score in, then TAKE TOP k times.",
  "io": {
    "inputs": [
      {"name": "scores", "type": "array<num>"},
      {"name": "k", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 200},
    "notes": ["Scores are whole numbers from 0 to 100.", "k is 0 or more; it may be larger than the number of scores."]
  },
  "blocks": {
    "allow": ["arith.add", "cmp.gt", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "heap.empty", "heap.insert", "heap.size", "heap.take", "heap.top", "lit.num", "logic.not", "new.max_heap", "new.min_heap", "var.get", "var.set"],
    "maxBlocks": 37
  },
  "limits": {"maxOps": 2650, "maxDepth": 32, "maxAlloc": 450},
  "hints": ["SET best TO NEW MAX HEAP, then FOR EACH score, INSERT it into best.", "FOR i FROM 0 TO k, add TAKE TOP best to the total: the largest score comes out first, then the next one.", "TAKE TOP on an empty heap is an error. When the scores run out before k, IF best IS EMPTY, stop adding."],
  "validators": {"output": "equal"},
