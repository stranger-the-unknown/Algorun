{
  "id": "last_stone",
  "version": 1,
  "title": "Last Stone",
  "world": "world_09",
  "chapter": "smash_two_largest",
  "tier": 3,
  "mode": "edge",
  "concepts": ["heap"],
  "prerequisites": [],
  "story": "Stones are smashed together two at a time, always the two heaviest. If they weigh the same, both are gone; if not, the lighter one is gone and the heavier one loses that much weight and goes back. What does the last stone weigh? If no stone is left, the answer is 0.",
  "io": {
    "inputs": [
      {"name": "stones", "type": "array<num>"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 1, "max": 100},
    "notes": ["1 to 100 stones; weights are whole numbers from 1 to 1000."]
  },
  "blocks": {
    "allow": ["arith.sub", "cmp.eq", "cmp.gt", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "heap.empty", "heap.insert", "heap.size", "heap.take", "heap.top", "lit.num", "new.max_heap", "new.min_heap", "var.get", "var.set"],
    "maxBlocks": 56
  },
  "limits": {"maxOps": 3800, "maxDepth": 32, "maxAlloc": 250},
  "hints": ["Keep the stones in a NEW MAX HEAP, so the heaviest is always on top.", "WHILE there are at least two stones: TAKE TOP twice, x and then y; IF x is GREATER THAN y, INSERT x MINUS y.", "When it ends there is one stone or none. IF the heap IS EMPTY, RETURN 0; reading TOP of an empty heap is an error."],
  "validators": {"output": "equal"},
