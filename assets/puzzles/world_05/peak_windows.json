{
  "id": "peak_windows",
  "version": 1,
  "title": "Peak Windows",
  "world": "world_05",
  "chapter": "sum_of_window_peaks",
  "tier": 4,
  "mode": "budget",
  "concepts": [
    "sliding_window"
  ],
  "prerequisites": [],
  "story": "Every stretch of exactly the given width has a peak, its largest reading. Add those peaks together and report the sum. If the width does not fit, report 0. Re-scanning each stretch from scratch is too slow for a long day.",
  "io": {
    "inputs": [
      {
        "name": "values",
        "type": "array<num>"
      },
      {
        "name": "width",
        "type": "num"
      }
    ],
    "output": {
      "type": "num"
    }
  },
  "constraints": {
    "n": {
      "min": 0,
      "max": 80
    },
    "notes": [
      "width does not fit",
      "rescanning every window is over budget",
      "the peak is not always the newest reading"
    ]
  },
  "blocks": {
    "allow": [
      "arith.add",
      "arith.max",
      "arith.sub",
      "arr.append",
      "arr.get",
      "arr.len",
      "arr.set",
      "cmp.eq",
      "cmp.ge",
      "cmp.gt",
      "cmp.le",
      "cmp.lt",
      "ctrl.else",
      "ctrl.for_range",
      "ctrl.if",
      "ctrl.return",
      "ctrl.while",
      "lit.num",
      "logic.and",
      "logic.or",
      "new.array",
      "var.dec",
      "var.get",
      "var.inc",
      "var.set"
    ],
    "maxBlocks": 95
  },
  "limits": {
    "maxOps": 6658,
    "maxDepth": 64,
    "maxAlloc": 200000
  },
  "performance": {
    "required": true
  },
  "hints": [
    "You need the maximum of each window, not the sum of its readings.",
    "A list can stand in for a deque: keep indexes whose readings can still be the peak, largest at the front.",
    "Drop an index when it slides out of the window, and drop smaller readings that sit behind a newer larger one."
  ],
  "validators": {
    "output": "equal"
  },
