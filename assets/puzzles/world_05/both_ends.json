  "prerequisites": [],
  "story": "Baskets of apples stand in a row on a long table. A guest may take exactly k baskets, and each time only the basket at the left end or at the right end of what is left. What is the largest number of apples the guest can leave with? The table can be long: adding up every possible choice from scratch is too slow.",
  "io": {
    "inputs": [
      {"name": "baskets", "type": "array<num>"},
      {"name": "k", "type": "num"}
    ],
    "output": {"type": "num"}
  },
  "constraints": {
    "n": {"min": 0, "max": 3000},
    "notes": ["0 to 3000 baskets of 0 to 100 apples.", "k is 0 to the number of baskets."]
  },
  "blocks": {
    "allow": ["arith.add", "arith.max", "arith.min", "arith.sub", "arr.get", "arr.len", "cmp.eq", "cmp.ge", "cmp.gt", "cmp.le", "cmp.lt", "cmp.ne", "ctrl.break", "ctrl.else", "ctrl.for_range", "ctrl.foreach", "ctrl.if", "ctrl.return", "ctrl.while", "lit.num", "logic.and", "logic.not", "logic.or", "var.dec", "var.get", "var.inc", "var.set"],
    "maxBlocks": 63
  },
  "limits": {"maxOps": 108050, "maxDepth": 32, "maxAlloc": 100},
  "performance": {"required": true, "baselineFactor": 5},
  "hints": ["However the guest picks, the baskets taken are some from the left end and the rest from the right end. Only one number is free: how many come from the left.", "Start with all k baskets from the left and add them up. Then hand back the last left basket and take one more from the right: the total changes by just those two baskets.", "Repeat that k times, keeping the MAX total seen. On step i the basket handed back is at position k MINUS i and the basket taken is at position LENGTH MINUS i."],
